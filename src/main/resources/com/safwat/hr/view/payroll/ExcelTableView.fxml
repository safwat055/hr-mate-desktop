<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ============================================================
     جدول إدخال البيرول — Excel Payroll Table
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0" prefWidth="1280.0" style="-fx-background-color: #F5F6FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="safwat.controllers.payroll.views.ExcelTableViewController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" style="-fx-background-color: #F5F6FA;">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 CARD: أدوات الجدول (Toolbar)
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>

                <Button fx:id="btn_infoo" prefHeight="32" prefWidth="36" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="ℹ" />
                <Button fx:id="btn_Refrech" onAction="#refreshTable" prefHeight="32" prefWidth="36" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="↻" />
                <Button fx:id="btn_Excel" onAction="#exportToExcel" prefHeight="32" prefWidth="36" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="📊" />
                <Button fx:id="btn_Pdf" onAction="#exportToPDF" prefHeight="32" prefWidth="36" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="📄" />
                <Button fx:id="btn_clear" onAction="#clearTableView" prefHeight="32" prefWidth="70" style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="مسح" />
                <Button fx:id="btn_insertRows" onAction="#add20Rows" prefHeight="32" prefWidth="90" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="+ 20 صف" />
                <Button fx:id="btn_delete" onAction="#deleteEmptyRows" prefHeight="32" prefWidth="80" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="حذف فارغ" />

                <Separator orientation="VERTICAL" />

                <!-- اتجاه الادخال -->
                <VBox spacing="4">
                    <RadioButton fx:id="toDown" contentDisplay="RIGHT" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="22" text="زر الادخال للانتقال لاسفل">
                        <toggleGroup>
                            <ToggleGroup fx:id="group" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="toRight" contentDisplay="RIGHT" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="22" text="زر الادخال للانتقال لليمين" toggleGroup="$group" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 CARD: إعدادات البيانات
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <padding><Insets bottom="10" left="12" right="12" top="10" /></padding>

                <!-- المجموعات -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <ComboBox fx:id="Combo_payrollGroup" editable="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="240" />
                        <Label prefHeight="28" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="مجموعة التعيين" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <ComboBox fx:id="Combo_elements_1" editable="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="240" />
                        <Label prefHeight="28" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="مجموعة العناصر" />
                    </HBox>
                </VBox>

                <Separator orientation="VERTICAL" />

                <!-- نوع رقم الصرف -->
                <VBox spacing="4">
                    <RadioButton fx:id="getMainCode" contentDisplay="RIGHT" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="22" text="رقم صرف اساسي">
                        <toggleGroup>
                            <ToggleGroup fx:id="group1" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="getSecondCode" contentDisplay="RIGHT" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="22" text="رقم صرف ثانوى" toggleGroup="$group1" />
                </VBox>

                <Separator orientation="VERTICAL" />

                <!-- الصرفيات الثابتة -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <ComboBox fx:id="combo_static" prefHeight="32" prefWidth="220" promptText="اختر من الصرفيات الثابتة" visibleRowCount="15" />
                        <Button fx:id="btn_savestatic" onAction="#savePayrollTable" prefHeight="32" prefWidth="70" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="حفظ" />
                        <Button fx:id="btn_clearstatic" onAction="#deleteFromPayrollTable" prefHeight="32" prefWidth="42" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="🗑" />
                    </HBox>
                    <CheckBox fx:id="useVoices" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="24" text="الاجابة الصوتية" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 CARD: جدول البيانات
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);" VBox.vgrow="ALWAYS">
                <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #1E3A5F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="بيانات البيرول" />
                <TableView fx:id="tableView" editable="true" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="600" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>