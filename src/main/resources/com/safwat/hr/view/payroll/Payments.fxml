<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ============================================================
     شاشة الصرفيات — Payments
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0" prefWidth="1280.0" style="-fx-background-color: #F5F6FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.safwat.hr.payroll.payments.PaymentsController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" style="-fx-background-color: #F5F6FA;">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 HEADER — شريط البحث الأول
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>

                <Button fx:id="btn_search" prefHeight="32" prefWidth="80" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="🔍 بحث" />
                <Button fx:id="btn_clear" prefHeight="32" prefWidth="70" style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="مسح" />

                <TextField fx:id="txt_searchValue" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="360" promptText="ادخل قيمة للبحث او اكتب الرقم القومي كامل" />

                <CheckBox fx:id="chk_showAction" nodeOrientation="RIGHT_TO_LEFT" prefHeight="28" style="-fx-border-color: #DDE1E7; -fx-border-radius: 4; -fx-padding: 4 8 4 8;" text="عرض الاجراءات" />

                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="pathLabel" prefHeight="22" prefWidth="140" style="-fx-text-fill: #6B7280;" />
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 TOOLBAR — شريط الأدوات (عرض + بيانات الموظف + الشهور)
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <padding><Insets bottom="8" left="12" right="12" top="8" /></padding>

                <Button fx:id="btn_view" prefHeight="32" prefWidth="80" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="عرض" />
                <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="PDF" />

                <Separator orientation="VERTICAL" />

                <TextField fx:id="txt_nationalID" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="140" promptText="رقم قومى" />
                <TextField fx:id="txt_empCode" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="120" promptText="رقم موظف" />
                <TextField fx:id="txt_empName" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="200" promptText="اسم الموظف" />

                <Separator orientation="VERTICAL" />

                <Label prefHeight="28" prefWidth="30" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="من" />
                <TextField fx:id="txt_startMonth" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="120" promptText="شهر سنة 2025 2" />

                <Label prefHeight="28" prefWidth="30" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="الي" />
                <TextField fx:id="txt_endMonth" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="120" promptText="شهر سنة 2025 2" />
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 RESULTS — جدول الصرفيات
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);" VBox.vgrow="ALWAYS">
                <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #1E3A5F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="نتائج البحث" />

                <TableView fx:id="table_payments" editable="true" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="500" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>