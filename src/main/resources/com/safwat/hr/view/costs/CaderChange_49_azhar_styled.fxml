<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0"
            prefWidth="1280.0" styleClass="app-bg"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="safwat.controllers.humanResources.costes.CaderChange_49_azharController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="app-bg">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- CARD: بيانات البحث -->
            <VBox spacing="0"
                  styleClass="card">
                <Label alignment="CENTER" maxWidth="Infinity"
                       styleClass="panel-header"
                       text="بيانات البحث"/>

                <VBox spacing="10">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <TextField fx:id="txt_costs_id" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160"
                                   promptText="رقم قومى"/>
                        <TextField fx:id="txt_costs_name" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="180" promptText="الاسم"/>
                        <TextField fx:id="txt_costs_num" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT"
                                   prefHeight="32" prefWidth="140" promptText="رقم الدعوى"/>

                        <Separator orientation="VERTICAL"/>

                        <Label prefHeight="28" prefWidth="70" styleClass="text-dark bold"
                               text="اساسي قديم"/>
                        <TextField fx:id="txt_costs_old" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT"
                                   prefHeight="32" prefWidth="70"/>
                        <Label prefHeight="28" prefWidth="70" styleClass="text-dark bold"
                               text="اساسي جديد"/>
                        <TextField fx:id="txt_costs_new" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT"
                                   prefHeight="32" prefWidth="70"/>
                        <Label prefHeight="28" prefWidth="70" styleClass="text-dark bold"
                               text="فرق الاساسي"/>
                        <Label fx:id="lbl_Basic_diff" alignment="CENTER" prefHeight="32" prefWidth="70"
                               styleClass="soft-box"/>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="من"/>
                        <TextField fx:id="txt_startDate_costs" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="100" promptText="تاريخ البداية"/>
                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="الى"/>
                        <TextField fx:id="txt_endDate_costs" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="100" promptText="تاريخ النهاية"/>

                        <Separator orientation="VERTICAL"/>

                        <Button fx:id="btn_getData" prefHeight="32" prefWidth="90"
                                styleClass="btn btn-purple bold"
                                text="تجهيز"/>
                        <Button fx:id="btn_calc" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-primary"
                                text="احتساب"/>
                        <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-danger"
                                text="PDF"/>
                        <Button fx:id="btn_clear" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-secondary"
                                text="مسح"/>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="10">
                        <VBox spacing="4" prefWidth="130">
                            <Label styleClass="text-navy bold" text="نوع الجداول"/>
                            <CheckBox fx:id="check_1" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                      text="عرض الاجمالي"/>
                            <CheckBox fx:id="check_2" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                      text="عرض تفصيلى"/>
                            <CheckBox fx:id="check_3" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                      text="عرض الخاضع"/>
                        </VBox>

                        <Separator orientation="VERTICAL"/>

                        <VBox spacing="4" prefWidth="120">
                            <Label styleClass="text-navy bold" text="البدلات"/>
                            <CheckBox fx:id="chek_Credit_Allowance" mnemonicParsing="false"
                                      nodeOrientation="RIGHT_TO_LEFT" selected="true" text="بدل اعتماد"/>
                            <CheckBox fx:id="chek_Reward_Allowence" mnemonicParsing="false"
                                      nodeOrientation="RIGHT_TO_LEFT" selected="true" text="حافز الاثابة"/>
                            <CheckBox fx:id="chek_TeacherAllowance" mnemonicParsing="false"
                                      nodeOrientation="RIGHT_TO_LEFT" selected="true" text="بدل معلم"/>
                            <CheckBox fx:id="chek_Performance_Allowence" mnemonicParsing="false"
                                      nodeOrientation="RIGHT_TO_LEFT" selected="true" text="حافز اداء"/>
                            <CheckBox fx:id="chek_reward" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                      selected="true" text="مكافاة"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLES -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="0"
                      styleClass="card"
                      HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header success"
                           text="بيان تفصيلي للتكاليف"/>
                    <TableView fx:id="table_change_percent" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="300" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>

                <VBox spacing="0"
                      styleClass="card"
                      prefWidth="380">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header"
                           text="اجمالى التكاليف"/>
                    <TableView fx:id="table_costes" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="300" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>
            </HBox>

            <!-- Summary -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="10"
                  styleClass="card">
                <padding>
                    <Insets bottom="8" left="12" right="12" top="8"/>
                </padding>
                <Label prefHeight="28" styleClass="text-navy bold"
                       text="اجمالي الخاصع لاجر الاشتراك:"/>
                <Label fx:id="lbl_sum1" alignment="CENTER" prefHeight="28" prefWidth="160"
                       styleClass="soft-box"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>