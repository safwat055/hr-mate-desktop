<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0"
            prefWidth="1280.0" styleClass="app-bg"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="safwat.controllers.humanResources.costes.VacationBalanceController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="app-bg">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- CARD: بيانات البحث -->
            <VBox spacing="0"
                  styleClass="card">
                <Label alignment="CENTER" maxWidth="Infinity"
                       styleClass="panel-header"
                       text="بيانات البحث"/>

                <VBox spacing="10">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <TextField fx:id="txt_vac_id" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160"
                                   promptText="رقم قومى"/>
                        <TextField fx:id="txt_vac_name" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="180" promptText="الاسم"/>
                        <TextField fx:id="txt_vac_cost_num" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT"
                                   prefHeight="32" prefWidth="160" promptText="رقم الدعوى"/>

                        <Separator orientation="VERTICAL"/>

                        <Label prefHeight="28" prefWidth="50" styleClass="text-dark bold"
                               text="النوع"/>
                        <ComboBox fx:id="combo_vac_type" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                  prefWidth="180"/>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="من"/>
                        <TextField fx:id="txt_vac_start" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="120" promptText="تاريخ البداية"/>

                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="الي"/>
                        <TextField fx:id="txt_vac_end" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="120" promptText="تاريخ النهاية"/>

                        <Separator orientation="VERTICAL"/>

                        <Button fx:id="btn_get" prefHeight="32" prefWidth="90"
                                styleClass="btn btn-purple bold"
                                text="تجهيز"/>
                        <Button fx:id="btn_calc" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-primary"
                                text="احتساب"/>
                        <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-danger"
                                text="PDF"/>
                        <Button fx:id="btn_clear" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-secondary"
                                text="مسح"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLES -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <VBox spacing="0"
                      styleClass="card"
                      HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header success"
                           text="تفاصيل الاجازات"/>
                    <TableView fx:id="table_vac_details" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="400" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>

                <VBox spacing="0"
                      styleClass="card"
                      prefWidth="300">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header"
                           text="اجمالى الاجازات"/>
                    <TableView fx:id="table_vac_total" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="400" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>