<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0"
            prefWidth="1280.0" styleClass="app-bg"
            xmlns="http://javafx.com/javafx/26"
            fx:controller="safwat.controllers.humanResources.costes.ShiftController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="app-bg">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- CARD: بيانات البحث -->
            <VBox spacing="0"
                  styleClass="card">
                <Label alignment="CENTER" maxWidth="Infinity"
                       styleClass="panel-header"
                       text="بيانات البحث"/>

                <VBox spacing="10">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="12"/>
                    </padding>

                    <!-- Row 1 -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <CheckBox fx:id="chek_wage" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                  prefHeight="28" text="مراعاة اجر الاشتراك"/>

                        <Separator orientation="VERTICAL"/>

                        <Label prefHeight="28" prefWidth="70" styleClass="text-dark bold"
                               text="اختر نوع"/>
                        <ComboBox fx:id="combo_shift_type" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                  prefWidth="200"/>

                        <Separator orientation="VERTICAL"/>

                        <TextField fx:id="txt_shift_id" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160"
                                   promptText="رقم قومى"/>
                        <TextField fx:id="txt_shift_name" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="180" promptText="الاسم"/>
                        <TextField fx:id="txt_shift_cost_num" alignment="CENTER" editable="false"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160"
                                   promptText="رقم الدعوى / شهر"/>
                    </HBox>

                    <!-- Row 2 -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="من"/>
                        <TextField fx:id="txt_shift_start" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="120" promptText="تاريخ البداية"/>

                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold"
                               text="الي"/>
                        <TextField fx:id="txt_shift_end" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                   prefHeight="32" prefWidth="120" promptText="تاريخ النهاية"/>

                        <Separator orientation="VERTICAL"/>

                        <Button fx:id="btn_get" onAction="#getData" prefHeight="32" prefWidth="90"
                                styleClass="btn btn-purple bold"
                                text="تجهيز"/>
                        <Button fx:id="btn_calc" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-primary"
                                text="احتساب"/>
                        <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-danger"
                                text="PDF"/>
                        <Button fx:id="btn_clear" prefHeight="32" prefWidth="70"
                                styleClass="btn btn-secondary"
                                text="مسح"/>

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- اعدادات التصدير -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" styleClass="text-navy bold"
                               text="اعدادات التصدير"/>
                        <CheckBox fx:id="chk_cost" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                  prefHeight="28" text="جدول التكاليف"/>
                        <CheckBox fx:id="chk_detalis" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                  prefHeight="28" text="تفاصيل التكاليف"/>
                        <CheckBox fx:id="chk_change" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                  prefHeight="28" text="تفاصيل الخاضع"/>
                        <CheckBox fx:id="chk_dayes" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT"
                                  prefHeight="28" text="تفاصيل الايام"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLES -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- تفاصيل الايام -->
                <VBox spacing="0"
                      styleClass="card"
                      prefWidth="220">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header purple"
                           text="تفاصيل الايام"/>
                    <TableView fx:id="table_dayes" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="400" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>

                <!-- تفاصيل التكاليف -->
                <VBox spacing="0"
                      styleClass="card"
                      prefWidth="380" HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity"
                           styleClass="panel-header success"
                           text="تفاصيل التكاليف"/>
                    <TableView fx:id="table_detalies" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                               nodeOrientation="RIGHT_TO_LEFT" prefHeight="400" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="8" left="8" right="8" top="8"/>
                        </padding>
                    </TableView>
                </VBox>

                <!-- اجمالى التكاليف + الخاضع -->
                <VBox spacing="10" prefWidth="380" HBox.hgrow="ALWAYS">
                    <VBox spacing="0"
                          styleClass="card"
                          VBox.vgrow="ALWAYS">
                        <Label alignment="CENTER" maxWidth="Infinity"
                               styleClass="panel-header"
                               text="اجمالى التكاليف"/>
                        <TableView fx:id="table_cost" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="260" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="8" left="8" right="8" top="8"/>
                            </padding>
                        </TableView>
                    </VBox>

                    <VBox spacing="0"
                          styleClass="card"
                          prefHeight="200">
                        <Label alignment="CENTER" maxWidth="Infinity"
                               styleClass="panel-header danger"
                               text="تفاصيل الاجر الخاضع"/>
                        <TableView fx:id="table_wage" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                                   nodeOrientation="RIGHT_TO_LEFT" prefHeight="160" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="8" left="8" right="8" top="8"/>
                            </padding>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>

        </VBox>
    </content>
</ScrollPane>