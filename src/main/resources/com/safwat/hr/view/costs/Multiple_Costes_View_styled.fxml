<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ============================================================
     عرض التكاليف المتعددة — Multiple Costes View
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0" prefWidth="1280.0" styleClass="app-bg" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="safwat.controllers.humanResources.costes.Multiple_Costes_Controller">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="app-bg">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 CARD: بيانات البحث
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" styleClass="card">
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header" text="بيانات البحث" />

                <VBox spacing="10">
                    <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

                    <!-- Row 1: بيانات الموظف + النسبة -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="50" styleClass="text-dark bold" text="النسبة" />
                        <ComboBox fx:id="combo_percent" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="170" />
                        <Label fx:id="lbl_percent" prefHeight="28" prefWidth="50" styleClass="text-secondary" />

                        <Separator orientation="VERTICAL" />

                        <TextField fx:id="txt_multiple_id" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160" promptText="الرقم القومى" />
                        <TextField fx:id="txt_multiple_name" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="180" promptText="الاسم" />
                        <TextField fx:id="txt_multiple_cost_num" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160" promptText="رقم الدعوى" />

                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Row 2: التواريخ + الأزرار -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold" text="من" />
                        <TextField fx:id="txt_multiple_start" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="110" promptText="تاريخ البداية" />

                        <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold" text="الى" />
                        <TextField fx:id="txt_multiple_end" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="110" promptText="تاريخ النهاية" />

                        <Separator orientation="VERTICAL" />

                        <Button fx:id="btn_get" prefHeight="32" prefWidth="110" styleClass="btn btn-purple bold" text="تجهيز البيانات" />
                        <Button fx:id="btn_calc" prefHeight="32" prefWidth="70" styleClass="btn btn-primary" text="احتساب" />
                        <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70" styleClass="btn btn-danger" text="PDF" />
                        <Button fx:id="btn_clear" prefHeight="32" prefWidth="70" styleClass="btn btn-secondary" text="مسح" />

                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ════════════════════════════════════════════════════════
                 TABLES: اجمالى التكاليف + تفاصيل التكاليف
                 ════════════════════════════════════════════════════════ -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- تفاصيل التكاليف (يسار) -->
                <VBox spacing="0" styleClass="card" HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header success" text="تفاصيل التكاليف" />
                    <TableView fx:id="table_deatales" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                    </TableView>
                </VBox>

                <!-- اجمالى التكاليف (يمين) -->
                <VBox spacing="0" styleClass="card" HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header" text="اجمالى التكاليف" />
                    <TableView fx:id="table_costes" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                    </TableView>
                </VBox>
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 TABLE: عدد الاشهر لكل درجة
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" styleClass="card" prefHeight="250">
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header purple" text="عدد الاشهر لكل درجة" />
                <TableView fx:id="table_degree_count" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="200" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>