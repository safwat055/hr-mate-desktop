<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ============================================================
     عرض التكاليف المتعددة — Multiple Costes View
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0" prefWidth="1280.0" style="-fx-background-color: #F5F6FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="safwat.controllers.humanResources.costes.Multiple_Costes_Controller">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" style="-fx-background-color: #F5F6FA;">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 CARD: بيانات البحث
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #1E3A5F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="بيانات البحث" />

                <VBox spacing="10">
                    <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

                    <!-- Row 1: بيانات الموظف + النسبة -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="50" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="النسبة" />
                        <ComboBox fx:id="combo_percent" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="170" />
                        <Label fx:id="lbl_percent" prefHeight="28" prefWidth="50" style="-fx-text-fill: #6B7280;" />

                        <Separator orientation="VERTICAL" />

                        <TextField fx:id="txt_multiple_id" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160" promptText="الرقم القومى" />
                        <TextField fx:id="txt_multiple_name" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="180" promptText="الاسم" />
                        <TextField fx:id="txt_multiple_cost_num" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32" prefWidth="160" promptText="رقم الدعوى" />

                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- Row 2: التواريخ + الأزرار -->
                    <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                        <Label prefHeight="28" prefWidth="30" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="من" />
                        <TextField fx:id="txt_multiple_start" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="110" promptText="تاريخ البداية" />

                        <Label prefHeight="28" prefWidth="30" style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="الى" />
                        <TextField fx:id="txt_multiple_end" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32" prefWidth="110" promptText="تاريخ النهاية" />

                        <Separator orientation="VERTICAL" />

                        <Button fx:id="btn_get" prefHeight="32" prefWidth="110" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;" text="تجهيز البيانات" />
                        <Button fx:id="btn_calc" prefHeight="32" prefWidth="70" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="احتساب" />
                        <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="PDF" />
                        <Button fx:id="btn_clear" prefHeight="32" prefWidth="70" style="-fx-background-color: #6B7280; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="مسح" />

                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- ════════════════════════════════════════════════════════
                 TABLES: اجمالى التكاليف + تفاصيل التكاليف
                 ════════════════════════════════════════════════════════ -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- تفاصيل التكاليف (يسار) -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);" HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="تفاصيل التكاليف" />
                    <TableView fx:id="table_deatales" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                    </TableView>
                </VBox>

                <!-- اجمالى التكاليف (يمين) -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);" HBox.hgrow="ALWAYS">
                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #1E3A5F; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="اجمالى التكاليف" />
                    <TableView fx:id="table_costes" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                    </TableView>
                </VBox>
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 TABLE: عدد الاشهر لكل درجة
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #DDE1E7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);" prefHeight="250">
                <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="عدد الاشهر لكل درجة" />
                <TableView fx:id="table_degree_count" maxHeight="1.7976931348623157E308" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="200" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="8" left="8" right="8" top="8" /></padding>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>