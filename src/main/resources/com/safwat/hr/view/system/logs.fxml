<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.safwat.hr.system.LogsController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: white;">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ff9800;" text="📊 سجل الأحداث" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblLogCount" style="-fx-text-fill: #666;" text="السجلات: 0" />
    </HBox>

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnRefresh" style="-fx-background-color: #2196f3; -fx-text-fill: white;" text="🔄 تحديث" />
        <Button fx:id="btnClear" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="🗑 مسح" />
        <Button fx:id="btnExport" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="📥 تصدير" />
        <CheckBox fx:id="chkAutoScroll" selected="true" text="تمرير تلقائي" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtFilter" prefWidth="200" promptText="بحث..." />
        <Button fx:id="btnFilter" style="-fx-background-color: #2196f3; -fx-text-fill: white;" text="🔍" />
        <Button fx:id="btnClearFilter" style="-fx-background-color: #9e9e9e; -fx-text-fill: white;" text="✖" />
    </HBox>

    <TextArea fx:id="txtLogs" prefHeight="400" editable="false"
              style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;" wrapText="true" />

</VBox>