<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.safwat.hr.system.PostgreSQLController"
      styleClass="app-bg"
      spacing="10" style="-fx-padding: 15;">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="fs-18 bold text-navy" text="📦 إدارة PostgreSQL" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblPgStatus" styleClass="bold" text="⏹ غير معروف" />
    </HBox>

    <Separator />

    <!-- معلومات PostgreSQL -->
    <GridPane hgap="15" vgap="8">
        <Label styleClass="bold" text="المسار:"          GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="lblPgPath" text="-"                GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label styleClass="bold" text="البيانات:"        GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="lblPgData" text="-"                GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label styleClass="bold" text="الحالة:"          GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="lblPgRunningStatus" text="❌ غير مشغول" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label styleClass="bold" text="المنفذ:"          GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="lblPgPort" text="5432"             GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label styleClass="bold" text="المستخدم:"        GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <Label fx:id="lblPgUser" text="admin"            GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label styleClass="bold" text="قاعدة البيانات:"  GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <Label fx:id="lblPgDatabase" text="hr_db"        GridPane.columnIndex="1" GridPane.rowIndex="5" />
    </GridPane>

    <Separator />

    <!-- أزرار التحكم -->
    <TitledPane expanded="true" text="🛠️ العمليات">
        <VBox spacing="10" style="-fx-padding: 10;">

            <!-- التهيئة -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 80;" text="تهيئة:" />
                <Button fx:id="btnInit" styleClass="btn btn-primary" text="🔧 تهيئة قاعدة البيانات" />
                <Label fx:id="lblInitStatus" styleClass="text-muted" text="" />
            </HBox>

            <Separator />

            <!-- التشغيل -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 80;" text="التشغيل:" />
                <Button fx:id="btnStart"   styleClass="btn btn-success" text="▶ تشغيل" />
                <Button fx:id="btnStop"    styleClass="btn btn-danger"  text="⏹ إيقاف" />
                <Button fx:id="btnRestart" styleClass="btn btn-purple"  text="🔄 إعادة تشغيل" />
                <CheckBox fx:id="chkServiceMode" text="خدمة (Windows)" />
            </HBox>

            <Separator />

            <!-- الخدمة (Windows only — تُخفى على Linux) -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 80;" text="الخدمة:" />
                <Button fx:id="btnInstallService" styleClass="btn btn-primary" text="📦 تثبيت" />
                <Button fx:id="btnDeleteService"  styleClass="btn btn-danger"  text="❌ حذف" />
            </HBox>

            <Separator />

            <!-- قاعدة البيانات -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 80;" text="قاعدة البيانات:" />
                <Button fx:id="btnCreateDb" styleClass="btn btn-secondary" text="➕ إنشاء" />
                <Button fx:id="btnDropDb"   styleClass="btn btn-danger"    text="🗑 حذف" />
                <Button fx:id="btnListDb"   styleClass="btn"               text="📋 عرض" />
            </HBox>

        </VBox>
    </TitledPane>

    <!-- النسخ الاحتياطي (2.7) -->
    <TitledPane expanded="true" text="💾 النسخ الاحتياطي">
        <VBox spacing="10" style="-fx-padding: 10;">

            <!-- نسخة احتياطية فورية -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 120;" text="نسخ احتياطي:" />
                <Button fx:id="btnBackupNow"
                        styleClass="btn btn-primary"
                        onAction="#handleBackupNow"
                        text="💾 نسخة احتياطية الآن" />
                <Label fx:id="lblBackupStatus" styleClass="text-muted" text="" />
            </HBox>

            <Separator />

            <!-- استعادة من ملف -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="bold" style="-fx-min-width: 120;" text="استعادة:" />
                <Button fx:id="btnRestoreFile"
                        styleClass="btn btn-purple"
                        onAction="#handleRestoreFromFile"
                        text="📂 استعادة من ملف..." />
                <Label styleClass="text-danger" style="-fx-font-size: 11px;"
                       text="⚠️ تحذير: تمسح البيانات الحالية" />
            </HBox>

        </VBox>
    </TitledPane>

    <!-- سجل العمليات -->
    <TitledPane expanded="false" text="📋 سجل العمليات">
        <TextArea fx:id="txtPgLogs" prefHeight="150" editable="false"
                  styleClass="mono-log" wrapText="true" />
    </TitledPane>

</VBox>
