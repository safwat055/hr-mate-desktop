<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<!--
    الإصلاح الجوهري:
    ────────────────────────────────────────────────────
    المشكلة القديمة:
        SplitPane → ScrollPane → AnchorPane(prefHeight=546) → TabPane
        ↑ AnchorPane بحجم ثابت يمنع الـ TabPane من الامتداد
        ↑ ScrollPane الخارجي يلف الكل بدل ما الـ ScrollPane
          الداخلي (بتاع كل view) يشتغل

    الحل:
        SplitPane → TabPane مباشرة (بدون ScrollPane أو AnchorPane وسيط)
        ↑ الـ TabPane بيأخذ كل مساحة الـ SplitPane
        ↑ كل Tab content = ScrollPane بتاع الـ FXML المحمل
          وده اللي بيظهر الـ scrollbar لو المحتوى أكبر من المساحة
-->

<VBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="807.0" prefWidth="1320.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.safwat.hr.main.MainViewController">

    <!-- ══════════════════════════════════════════
         Menu Bar
    ══════════════════════════════════════════ -->
    <MenuBar VBox.vgrow="NEVER">
        <menus>
         <Menu mnemonicParsing="false" text="Unspecified Menu">
           <items>
             <MenuItem mnemonicParsing="false" text="Action 1" />
           </items>
         </Menu>
            <Menu mnemonicParsing="false" text="عرض">
                <items>
                    <Menu mnemonicParsing="false" text="تقارير">
                        <items>
                            <MenuItem mnemonicParsing="false" text="تقارير تسويات" />
                            <SeparatorMenuItem mnemonicParsing="false" />
                            <MenuItem mnemonicParsing="false" onAction="#openPayrollReport" text="تقارير بيرول" />
                            <SeparatorMenuItem mnemonicParsing="false" />
                            <MenuItem mnemonicParsing="false" text="تقارير اجازات" />
                            <SeparatorMenuItem mnemonicParsing="false" />
                            <MenuItem mnemonicParsing="false" text="تقارير اجور" />
                        </items>
                    </Menu>
                    <SeparatorMenuItem mnemonicParsing="false" />
                    <Menu mnemonicParsing="false" text="واجهات">
                        <items>
                            <MenuItem mnemonicParsing="false" text="تقارير تسويات" />
                            <MenuItem mnemonicParsing="false" text="تقارير بيرول" />
                            <MenuItem mnemonicParsing="false" text="تقارير اجازات" />
                            <MenuItem mnemonicParsing="false" text="تقارير اجور" />
                        </items>
                    </Menu>
                </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
                <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <!-- ══════════════════════════════════════════
         SplitPane الرئيسي — يأخذ كل المساحة المتبقية
    ══════════════════════════════════════════ -->
    <SplitPane dividerPositions="0.18, 0.95" focusTraversable="true" VBox.vgrow="ALWAYS">
        <items>

            <!-- ── القائمة الجانبية (يمين) ── -->
            <AnchorPane fx:id="rightPane" maxWidth="220" minWidth="160" prefWidth="180">
                <ScrollPane fitToHeight="true" fitToWidth="true" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                    <content>
                        <VBox fx:id="rightPanelContent" alignment="TOP_CENTER">
                            <Label fx:id="lblParts" alignment="CENTER" prefHeight="38" prefWidth="176" text="الاقسام" />
                            <Accordion>
                                <panes>
                                    <TitledPane alignment="CENTER" animated="false" expanded="false" text="استحقاقات">
                                        <content>
                                            <VBox alignment="TOP_CENTER" spacing="8">
                                                <padding><Insets bottom="8" left="5" right="5" top="8" /></padding>
                                                <Button fx:id="btn_payments" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تقارير صرف" />
                                                <Button fx:id="btn_changeCard" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="اجر الاشتراك" />
                                                <Button fx:id="btn_PayrollVocab" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مفردات" />
                                                <Button fx:id="btn_records" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="سجلات" />
                                                <Button fx:id="btn_tableView" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="شيت الادخال" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="اضافة موظف" />
                                                <Button fx:id="btn_payManager" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مدير الاستحقاقات" />
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane alignment="CENTER" animated="false" expanded="false" text="تسويات">
                                        <content>
                                            <VBox alignment="TOP_CENTER" spacing="8">
                                                <padding><Insets bottom="8" left="5" right="5" top="8" /></padding>
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="البيانات الاساسية" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="بيانات موظف" />
                                                <Button fx:id="btn_scaleView" prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تدرج راتب" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مدير التسويات" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تقارير" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مدير التقارير" />
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane alignment="CENTER" animated="false" expanded="false" text="اجور متغيرة">
                                        <content>
                                            <VBox alignment="TOP_CENTER" spacing="8">
                                                <padding><Insets bottom="8" left="5" right="5" top="8" /></padding>
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="سجل موظف" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="بيانات موظف" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="استمارة التغطية" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="استمارة الاجور" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="اجر الاشتراك" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تقارير" />
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane alignment="CENTER" animated="false" expanded="false" text="اجازات">
                                        <content>
                                            <VBox alignment="TOP_CENTER" spacing="8">
                                                <padding><Insets bottom="8" left="5" right="5" top="8" /></padding>
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="سجل موظف" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="بيانات موظف" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تقارير" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مدير الاجازات" />
                                            </VBox>
                                        </content>
                                    </TitledPane>

                                    <TitledPane alignment="CENTER" animated="false" expanded="false" text="موارد بشرية">
                                        <content>
                                            <VBox alignment="TOP_CENTER" spacing="8">
                                                <padding><Insets bottom="8" left="5" right="5" top="8" /></padding>
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="ملف الخدمة" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="انتدابات / اعارات" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="تقارير" />
                                                <Button prefHeight="26" prefWidth="182" styleClass="nav-btn" text="مدير م بشرية" />
                                            </VBox>
                                        </content>
                                    </TitledPane>
                                </panes>
                            </Accordion>
                        </VBox>
                    </content>
                </ScrollPane>
            </AnchorPane>

            <!-- ── منطقة التابات — مباشرة بدون ScrollPane وسيط ──
                 الـ TabPane نفسه يملأ الـ SplitPane كله.
                 كل Tab بيحمل ScrollPane من الـ FXML الخاص به
                 وده اللي بيظهر الـ scrollbar لو المحتوى أكبر. -->
            <TabPane fx:id="tab" tabClosingPolicy="ALL_TABS">
                <tabs>
                    <Tab fx:id="mainTab" closable="false" text="الرئيسية">
                  <content>
                     <BorderPane fx:id="mainImagePane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                        <left>
                           <VBox fx:id="mainLeftBox" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" BorderPane.alignment="TOP_CENTER" />
                        </left>
                        <center>
                           <StackPane fx:id="mainImageCenter" BorderPane.alignment="CENTER">
                              <ImageView fitHeight="578.0" fitWidth="825.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@dashpoard2.jpeg" />
                                 </image>
                              </ImageView>
                           </StackPane>
                        </center>
                        <right>
                           <VBox fx:id="mainRightBox" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" BorderPane.alignment="TOP_CENTER" />
                        </right>
                     </BorderPane>
                  </content>
                    </Tab>
                </tabs>
            </TabPane>

            <!-- ── الشريط الأيسر (إشعارات + أيقونات) ── -->
            <AnchorPane fx:id="leftPane" maxWidth="60" minWidth="60" prefWidth="60">
                <VBox alignment="TOP_CENTER" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                    <VBox fx:id="toolbar" prefWidth="60">
                        <Label fx:id="badge" prefHeight="20" prefWidth="20" />
                        <Label fx:id="bellIcon" prefHeight="38" prefWidth="55" />
                    </VBox>
                    <Button fx:id="btn_mail" mnemonicParsing="false" />
                    <Button fx:id="btn_chat" mnemonicParsing="false" onAction="#openChatView" />
                    <Button fx:id="btn_report" mnemonicParsing="false" />
                </VBox>
            </AnchorPane>

        </items>
    </SplitPane>

    <!-- ══════════════════════════════════════════
         Status Bar
    ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="5" VBox.vgrow="NEVER">
        <padding><Insets bottom="3" left="3" right="3" top="3" /></padding>
        <Label maxWidth="Infinity" prefHeight="16" text="rightstatus" HBox.hgrow="ALWAYS">
            <font><Font size="11" /></font>
            <textFill><Color red="0.625" green="0.625" blue="0.625" /></textFill>
        </Label>
        <Pane HBox.hgrow="ALWAYS" />
        <Label fx:id="leftLable" prefHeight="16" prefWidth="82" text="leftStatus" HBox.hgrow="NEVER">
            <font><Font size="11" /></font>
            <textFill><Color red="0.625" green="0.625" blue="0.625" /></textFill>
        </Label>
    </HBox>

</VBox>
