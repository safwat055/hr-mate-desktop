<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safwat.hr.controller.backendSetting.SettingsController"
            prefWidth="1000" prefHeight="680"
            styleClass="settings-root">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox styleClass="settings-header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <!-- Icon + Title -->
            <Label text="⚙" styleClass="header-icon"/>
            <VBox spacing="2">
                <Label text="إعدادات التطبيق" styleClass="header-title"/>
                <Label text="إدارة ملف application.properties" styleClass="header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search -->
            <TextField fx:id="searchField"
                       promptText="🔍  ابحث عن مفتاح أو قيمة..."
                       prefWidth="240"
                       styleClass="search-field"
                       onKeyReleased="#onSearch"/>

            <!-- Toolbar buttons -->
            <Button fx:id="btnRefresh" text="↻  تحديث" styleClass="btn-toolbar" onAction="#onRefresh"/>
            <Button fx:id="btnBackup" text="💾  نسخة احتياطية" styleClass="btn-toolbar,btn-purple" onAction="#onBackup"/>
            <Button fx:id="btnAdd" text="➕  إعداد جديد" styleClass="btn-toolbar,btn-green" onAction="#onAdd"/>
            <Button fx:id="btnBackups" text="🗂  سجل النسخ" styleClass="btn-toolbar" onAction="#onShowBackups"/>
        </HBox>
    </top>

    <!-- ═══════════════════ BODY ═══════════════════ -->
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.22" styleClass="main-split">

            <!-- ── Sidebar: category list ── -->
            <VBox styleClass="sidebar" minWidth="180" maxWidth="240">
                <padding>
                    <Insets top="10" right="0" bottom="10" left="0"/>
                </padding>

                <Label text="التصنيفات" styleClass="sidebar-section-label">
                    <VBox.margin>
                        <Insets bottom="6" left="14"/>
                    </VBox.margin>
                </Label>

                <ListView fx:id="categoryList"
                          styleClass="category-list"
                          VBox.vgrow="ALWAYS"
                          onMouseClicked="#onCategorySelected"/>
            </VBox>

            <!-- ── Main area ── -->
            <VBox VBox.vgrow="ALWAYS" styleClass="entries-area">

                <!-- category header bar -->
                <HBox styleClass="category-bar" alignment="CENTER_LEFT" spacing="10">
                    <padding>
                        <Insets top="10" right="16" bottom="10" left="16"/>
                    </padding>
                    <Label fx:id="currentCategoryLabel" text="اختر تصنيفًا" styleClass="category-bar-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="entryCountLabel" text="" styleClass="entry-count-badge"/>
                </HBox>

                <!-- entries scroll -->
                <ScrollPane fx:id="entriesScroll"
                            fitToWidth="true"
                            styleClass="entries-scroll"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="entriesContainer" styleClass="entries-container" spacing="6">
                        <padding>
                            <Insets top="10" right="14" bottom="10" left="14"/>
                        </padding>

                        <!-- placeholder shown while loading -->
                        <VBox fx:id="loadingPlaceholder" alignment="CENTER" spacing="12"
                              prefHeight="300">
                            <Label text="⟳" styleClass="loading-icon"/>
                            <Label text="جاري تحميل الإعدادات..." styleClass="loading-text"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </SplitPane>
    </center>

    <!-- ═══════════════════ FOOTER ═══════════════════ -->
    <bottom>
        <HBox styleClass="settings-footer" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <!-- status -->
            <Label fx:id="statusLabel" text="جاهز" styleClass="status-label"/>

            <!-- progress -->
            <ProgressIndicator fx:id="progressIndicator"
                               prefWidth="16" prefHeight="16"
                               visible="false"
                               styleClass="footer-spinner"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- pending badge -->
            <Label fx:id="pendingBadge" text="" styleClass="pending-badge" visible="false"/>

            <Button fx:id="btnDiscard"
                    text="↩  تجاهل"
                    styleClass="btn-danger-outline"
                    visible="false"
                    onAction="#onDiscard"/>

            <Button fx:id="btnSaveAll"
                    text="💾  حفظ الكل"
                    styleClass="btn-primary"
                    disable="true"
                    onAction="#onSaveAll"/>
        </HBox>
    </bottom>

</BorderPane>
