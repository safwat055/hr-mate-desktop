<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            prefHeight="740" prefWidth="1100"
            styleClass="stg-root"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.backendSetting.SettingsController">

    <!-- ═══ HEADER ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="stg-header">
            <padding>
                <Insets bottom="14" left="20" right="20" top="14"/>
            </padding>

            <Label styleClass="stg-header-icon" text="⚙"/>
            <VBox spacing="2">
                <Label styleClass="stg-header-title" text="إعدادات التطبيق"/>
                <Label fx:id="headerSubtitle" styleClass="stg-header-subtitle"
                       text="إدارة ملفات الإعدادات"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search -->
            <TextField fx:id="searchField" onKeyReleased="#onSearch"
                       prefWidth="240"
                       promptText="🔍  ابحث عن مفتاح أو قيمة..."
                       styleClass="stg-search-field"/>

            <!-- Toolbar buttons -->
            <Button fx:id="btnRefresh" onAction="#onRefresh"
                    styleClass="stg-btn-toolbar" text="↻  تحديث"/>
            <Button fx:id="btnBackup" onAction="#onBackup"
                    styleClass="stg-btn-toolbar,stg-btn-purple" text="💾  نسخة احتياطية"/>
            <Button fx:id="btnAdd" onAction="#onAdd"
                    styleClass="stg-btn-toolbar,stg-btn-green" text="➕  إعداد جديد"/>
            <Button fx:id="btnBackups" onAction="#onShowBackups"
                    styleClass="stg-btn-toolbar" text="🗂  سجل النسخ"/>
        </HBox>
    </top>

    <!-- ═══ BODY ═══ -->
    <center>
        <TabPane fx:id="mainTabPane" styleClass="stg-tab-pane-dark"
                 tabClosingPolicy="UNAVAILABLE">

            <!-- TAB 1 — application.properties -->
            <Tab text="اعدادات التطبيق">
                <SplitPane fx:id="propsSplitPane" dividerPositions="0.22"
                           styleClass="stg-main-split">

                    <VBox maxWidth="240" minWidth="180" styleClass="stg-sidebar">
                        <padding>
                            <Insets bottom="10" left="0" right="0" top="10"/>
                        </padding>

                        <Label styleClass="stg-sidebar-section-label" text="التصنيفات">
                            <VBox.margin>
                                <Insets bottom="6" left="14"/>
                            </VBox.margin>
                        </Label>

                        <ListView fx:id="categoryList" onMouseClicked="#onCategorySelected"
                                  styleClass="stg-category-list" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox styleClass="stg-entries-area" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-category-bar">
                            <padding>
                                <Insets bottom="10" left="16" right="16" top="10"/>
                            </padding>
                            <Label fx:id="currentCategoryLabel"
                                   styleClass="stg-category-bar-title"
                                   text="اختر تصنيفًا"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="entryCountLabel"
                                   styleClass="stg-entry-count-badge" text=""/>
                        </HBox>

                        <ScrollPane fx:id="entriesScroll" fitToWidth="true"
                                    styleClass="stg-entries-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="entriesContainer" spacing="6"
                                  styleClass="stg-entries-container">
                                <padding>
                                    <Insets bottom="10" left="14" right="14" top="10"/>
                                </padding>

                                <VBox fx:id="loadingPlaceholder" alignment="CENTER"
                                      prefHeight="300" spacing="12">
                                    <Label styleClass="stg-loading-icon" text="⟳"/>
                                    <Label styleClass="stg-loading-text"
                                           text="جاري تحميل الإعدادات..."/>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </SplitPane>
            </Tab>

            <!-- TAB 2 — app_config.json -->
            <Tab text="اعدادات المستخدم">
                <SplitPane fx:id="jsonSplitPane" dividerPositions="0.22"
                           styleClass="stg-main-split">

                    <VBox maxWidth="240" minWidth="180" styleClass="stg-sidebar">
                        <padding>
                            <Insets bottom="10" left="0" right="0" top="10"/>
                        </padding>

                        <Label styleClass="stg-sidebar-section-label" text="الأقسام">
                            <VBox.margin>
                                <Insets bottom="6" left="14"/>
                            </VBox.margin>
                        </Label>

                        <ListView fx:id="jsonCategoryList" onMouseClicked="#onJsonCategorySelected"
                                  styleClass="stg-category-list" VBox.vgrow="ALWAYS"/>
                    </VBox>

                    <VBox styleClass="stg-entries-area" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-category-bar">
                            <padding>
                                <Insets bottom="10" left="16" right="16" top="10"/>
                            </padding>
                            <Label fx:id="jsonCategoryLabel"
                                   styleClass="stg-category-bar-title"
                                   text="اختر قسمًا"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="jsonEntryCountLabel"
                                   styleClass="stg-entry-count-badge" text=""/>
                        </HBox>

                        <ScrollPane fx:id="jsonEntriesScroll" fitToWidth="true"
                                    styleClass="stg-entries-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="jsonEntriesContainer" spacing="6"
                                  styleClass="stg-entries-container">
                                <padding>
                                    <Insets bottom="10" left="14" right="14" top="10"/>
                                </padding>

                                <VBox fx:id="jsonLoadingPlaceholder" alignment="CENTER"
                                      prefHeight="300" spacing="12">
                                    <Label styleClass="stg-loading-icon" text="⟳"/>
                                    <Label styleClass="stg-loading-text"
                                           text="جاري تحميل إعدادات JSON..."/>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </SplitPane>
            </Tab>

        </TabPane>
    </center>

    <!-- ═══ FOOTER ═══ -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-footer">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10"/>
            </padding>

            <Label fx:id="statusLabel" styleClass="stg-status-label" text="جاهز"/>

            <ProgressIndicator fx:id="progressIndicator" prefHeight="16" prefWidth="16"
                               styleClass="stg-footer-spinner" visible="false"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="pendingBadge" styleClass="stg-pending-badge"
                   text="" visible="false"/>

            <Button fx:id="btnDiscard" onAction="#onDiscard"
                    styleClass="stg-btn-danger-outline"
                    text="↩  تجاهل" visible="false"/>

            <Button fx:id="btnSaveAll" disable="true" onAction="#onSaveAll"
                    styleClass="stg-btn-primary" text="💾  حفظ الكل"/>
        </HBox>
    </bottom>

</BorderPane>