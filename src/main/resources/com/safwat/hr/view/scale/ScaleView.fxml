                                <Button fx:id="btn_bounsRivalDelRow" prefHeight="26" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B;                                                -fx-background-radius: 4; -fx-cursor: hand;" text="- حذف" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- ══════════════════════════════════════════════════════
                 5. نتائج البحث
            ══════════════════════════════════════════════════════ -->
            <VBox style="-fx-background-color: white; -fx-border-color: #DDE1E7;                          -fx-border-radius: 6; -fx-background-radius: 6;                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,2);">
                <Label alignment="CENTER" maxWidth="Infinity" style="-fx-background-color: #374151; -fx-text-fill: white;                               -fx-font-weight: bold; -fx-font-size: 13;                               -fx-background-radius: 6 6 0 0; -fx-padding: 8;" text="نتائج البحث" />
                <TableView fx:id="table_result" maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="300">
                    <padding><Insets bottom="6" left="6" right="6" top="4" /></padding>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
