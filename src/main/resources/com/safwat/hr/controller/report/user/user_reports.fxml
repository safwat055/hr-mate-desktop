<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox nodeOrientation="RIGHT_TO_LEFT" spacing="10" style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.safwat.hr.controller.report.user.UserReportsController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="تقاريري" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnRefresh" onAction="#loadReports" text="🔄 تحديث" />
        <Button fx:id="btnNewReport" onAction="#openNewReport" text="➕ تقرير جديد" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colReportId" prefWidth="80" text="رقم التقرير" />
            <TableColumn fx:id="colReportName" prefWidth="180" text="اسم التقرير" />
            <TableColumn fx:id="colStatus" prefWidth="100" text="الحالة" />
            <TableColumn fx:id="colSubmittedTime" prefWidth="140" text="وقت التقديم" />
            <TableColumn fx:id="colFinishedTime" prefWidth="140" text="وقت الانتهاء" />
            <TableColumn fx:id="colMessage" prefWidth="200" text="الرسالة" />
            <TableColumn fx:id="colActions" prefWidth="150" text="إجراءات" />
        </columns>
    </TableView>

    <!-- Status Bar -->
    <Label fx:id="lblStatus" style="-fx-text-fill: #666;" text="جاري التحميل..." />
</VBox>
