<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.safwat.hr.controller.admin.user.ChangePasswordController"
      styleClass="stg-dialog" spacing="12.0" prefWidth="420.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="🔑 تغيير كلمة المرور" styleClass="stg-dialog-title"/>
    <Label fx:id="lblUser" text="" styleClass="stg-dialog-subtitle"/>

    <PasswordField fx:id="txtCurrent"
                   promptText="كلمة المرور الحالية"
                   prefWidth="380.0"
                   styleClass="stg-field-dark"/>

    <PasswordField fx:id="txtNew"
                   promptText="كلمة المرور الجديدة (6 أحرف على الأقل)"
                   prefWidth="380.0"
                   styleClass="stg-field-dark"/>

    <PasswordField fx:id="txtConfirm"
                   promptText="تأكيد كلمة المرور الجديدة"
                   prefWidth="380.0"
                   styleClass="stg-field-dark"
                   onAction="#changePassword"/>

    <Label fx:id="lblError" text=""
           styleClass="stg-field-error"
           wrapText="true"
           visible="false" managed="false"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel"
                text="إلغاء"
                styleClass="stg-btn-dialog-secondary"
                onAction="#close"/>
        <Button fx:id="btnSave"
                text="💾 حفظ"
                styleClass="stg-btn-dialog-primary"
                onAction="#changePassword"/>
    </HBox>
</VBox>