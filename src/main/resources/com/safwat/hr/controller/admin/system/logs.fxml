<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            styleClass="stg-app-bg"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.admin.system.LogsController">

    <!-- ═══ Header ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="stg-page-header">
            <padding>
                <Insets bottom="14" left="20" right="20" top="14"/>
            </padding>
            <Label styleClass="stg-header-icon" text="📊"/>
            <VBox spacing="2">
                <Label styleClass="stg-page-title" text="سجل الأحداث"/>
                <Label styleClass="stg-page-subtitle" text="مراقبة سجلات النظام الحيّة"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblLogCount" styleClass="stg-status-badge" text="السجلات: 0"/>
        </HBox>
    </top>

    <!-- ═══ Toolbar ═══ -->
    <right>
        <!-- مش مستخدم -->
    </right>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- Toolbar -->
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="6"
                      styleClass="stg-toolbar-dark">
                <Button fx:id="btnRefresh" styleClass="stg-btn-secondary" text="🔄 تحديث"/>
                <Button fx:id="btnClear" styleClass="stg-btn-danger" text="🗑 مسح"/>
                <Button fx:id="btnExport" styleClass="stg-btn-primary" text="📥 تصدير"/>
                <CheckBox fx:id="chkAutoScroll" selected="true" styleClass="stg-checkbox-dark"
                          text="تمرير تلقائي"/>
                <TextField fx:id="txtFilter" styleClass="stg-search-pill"
                           promptText="🔍 بحث..." prefWidth="240"/>
                <Button fx:id="btnFilter" styleClass="stg-icon-btn,stg-icon-btn-accent" text="🔍"/>
                <Button fx:id="btnClearFilter" styleClass="stg-icon-btn" text="✖"/>
            </FlowPane>

            <!-- Card: السجلات -->
            <VBox spacing="0" styleClass="stg-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                    <Label styleClass="stg-card-icon" text="📄"/>
                    <Label styleClass="stg-card-title" text="محتوى السجل"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label styleClass="stg-info-muted" text="live"/>
                </HBox>
                <TextArea fx:id="txtLogs"
                          editable="false"
                          wrapText="true"
                          styleClass="stg-textarea-dark,stg-textarea-in-card"
                          maxHeight="Infinity"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>