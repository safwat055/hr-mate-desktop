<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     شاشة "تخصيص الواجهة" — Appearance Settings
     ✅ RTL كامل
     ✅ كلاسات stg- لتجنب التداخل مع الثيم الأساسي
     ============================================================ -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safwat.hr.controller.appearance.AppearanceSettingsController"
            prefWidth="900.0" prefHeight="640.0"
            nodeOrientation="RIGHT_TO_LEFT"
            styleClass="stg-root">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="stg-header">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <Label styleClass="stg-header-icon" text="🎛"/>
            <VBox spacing="2">
                <Label styleClass="stg-header-title" text="تخصيص الواجهة"/>
                <Label fx:id="subtitleLabel" styleClass="stg-header-subtitle" text=""/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label styleClass="stg-field-label" text="الواجهة:"/>
            <ComboBox fx:id="viewCombo" prefWidth="220"
                      promptText="اختر واجهة..."
                      styleClass="stg-combo-light"/>
        </HBox>
    </top>

    <!-- ═══════════════════ BODY ═══════════════════ -->
    <center>
        <SplitPane dividerPositions="0.22" styleClass="stg-main-split">

            <!-- ── Sidebar: التصنيفات ── -->
            <VBox minWidth="170" maxWidth="230" styleClass="stg-sidebar">
                <padding>
                    <Insets top="10" bottom="10"/>
                </padding>

                <Label text="التخصيصات" styleClass="stg-sidebar-section-label">
                    <VBox.margin>
                        <Insets bottom="6" right="14"/>
                    </VBox.margin>
                </Label>

                <ListView fx:id="categoryList" VBox.vgrow="ALWAYS"
                          styleClass="stg-category-list"/>
            </VBox>

            <!-- ── منطقة المحتوى ── -->
            <StackPane fx:id="contentArea" styleClass="stg-entries-area"/>

        </SplitPane>
    </center>

</BorderPane>