<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     شاشة "تخصيص الواجهة" — Appearance Settings
     ✅ RTL كامل
     ✅ لون ListView = نفس لون الخلفية
     ✅ ComboBox بخط فاتح (class="combo-light")
     ============================================================ -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safwat.hr.controller.appearance.AppearanceSettingsController"
            prefWidth="900.0" prefHeight="640.0"
            nodeOrientation="RIGHT_TO_LEFT"
            styleClass="settings-root">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="12"
              styleClass="settings-header">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <Label text="🎛" style="-fx-font-size:20px;"/>
            <VBox spacing="2">
                <Label text="تخصيص الواجهة"
                       styleClass="header-title"/>
                <Label fx:id="subtitleLabel" text=""
                       styleClass="header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="الواجهة:"
                   style="-fx-font-size:11px; -fx-text-fill:#8b90b8;"/>
            <ComboBox fx:id="viewCombo" prefWidth="220"
                      promptText="اختر واجهة..."
                      styleClass="combo-light"/>
        </HBox>
    </top>

    <!-- ═══════════════════ BODY ═══════════════════ -->
    <center>
        <SplitPane dividerPositions="0.22" styleClass="main-split">

            <!-- ── Sidebar: التصنيفات ── -->
            <VBox minWidth="170" maxWidth="230"
                  styleClass="sidebar">
                <padding>
                    <Insets top="10" bottom="10"/>
                </padding>

                <Label text="التخصيصات"
                       styleClass="sidebar-section-label">
                    <VBox.margin>
                        <Insets bottom="6" right="14"/>
                    </VBox.margin>
                </Label>

                <ListView fx:id="categoryList" VBox.vgrow="ALWAYS"
                          styleClass="category-list"/>
            </VBox>

            <!-- ── منطقة المحتوى ── -->
            <StackPane fx:id="contentArea"
                       style="-fx-background-color:#1a1d2e;"/>

        </SplitPane>
    </center>

</BorderPane>