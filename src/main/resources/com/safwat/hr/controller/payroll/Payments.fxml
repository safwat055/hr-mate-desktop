<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     شاشة الصرفيات — Payments
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="1200.0" prefWidth="1280.0"
            styleClass="app-bg" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.payroll.payments.PaymentsController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="card">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 HEADER — شريط البحث الأول
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" styleClass="card">
                <padding>
                    <Insets bottom="8" left="12" right="12" top="8"/>
                </padding>

                <Button fx:id="btn_search" prefHeight="32" prefWidth="80" text="🔍 بحث">
                    <styleClass>
                        <String fx:value="btn-primary"/>
                        <String fx:value="bold"/>
                        <String fx:value="border-gray"/>
                    </styleClass>
                </Button>
                <Button fx:id="btn_clear" prefHeight="32" prefWidth="70" styleClass="btn-secondary" text="مسح"/>

                <TextField fx:id="txt_searchValue" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                           prefWidth="360" promptText="ادخل قيمة للبحث او اكتب الرقم القومي كامل"/>

                <CheckBox fx:id="chk_showAction" nodeOrientation="RIGHT_TO_LEFT" prefHeight="28" text="عرض الاجراءات">
                    <styleClass>
                        <String fx:value="check-box"/>
                        <String fx:value="bold"/>
                    </styleClass>
                </CheckBox>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="pathLabel" prefHeight="22" prefWidth="140" styleClass="text-secondary"/>
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 TOOLBAR — شريط الأدوات (عرض + بيانات الموظف + الشهور)
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" styleClass="card">
                <padding>
                    <Insets bottom="8" left="12" right="12" top="8"/>
                </padding>

                <Button fx:id="btn_view" prefHeight="32" prefWidth="80" text="عرض">
                    <styleClass>
                        <String fx:value="btn-primary"/>
                        <String fx:value="bold"/>
                        <String fx:value="divider-border"/>
                    </styleClass>
                </Button>
                <Button fx:id="btn_pdf" prefHeight="32" prefWidth="70" styleClass="btn-iconFlat"/>

                <Separator orientation="VERTICAL"/>

                <TextField fx:id="txt_nationalID" alignment="CENTER" nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                           prefWidth="140" promptText="رقم قومى"/>
                <TextField fx:id="txt_empCode" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT"
                           prefHeight="32" prefWidth="120" promptText="رقم موظف"/>
                <TextField fx:id="txt_empName" alignment="CENTER" editable="false" nodeOrientation="RIGHT_TO_LEFT"
                           prefHeight="32" prefWidth="200" promptText="اسم الموظف"/>

                <Separator orientation="VERTICAL"/>

                <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold" text="من"/>
                <TextField fx:id="txt_startMonth" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32"
                           prefWidth="120" promptText="شهر سنة 2025 2"/>

                <Label prefHeight="28" prefWidth="30" styleClass="text-dark bold" text="الي"/>
                <TextField fx:id="txt_endMonth" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="32"
                           prefWidth="120" promptText="شهر سنة 2025 2"/>
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 RESULTS — جدول الصرفيات
                 ════════════════════════════════════════════════════════ -->
            <VBox spacing="0" styleClass="card" VBox.vgrow="ALWAYS">
                <Label alignment="CENTER" maxWidth="Infinity" prefHeight="45.0" prefWidth="1242.0" text="نتائج البحث">
                    <styleClass>
                        <String fx:value="panel-header"/>
                        <String fx:value="fs-18"/>
                    </styleClass>
                </Label>

                <TableView fx:id="table_payments" editable="true" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="500" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="8" left="8" right="8" top="8"/>
                    </padding>
                    <styleClass>
                        <String fx:value="fs-14"/>
                        <String fx:value="bold"/>
                    </styleClass>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
