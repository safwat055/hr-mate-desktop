<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     سجلات الصرفيات — Payroll Records
     Styled per Salary Scale v1.0 Design System
     ============================================================ -->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<TabPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="1231.0" prefWidth="1397.0" tabClosingPolicy="ALL_TABS"
         xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.safwat.hr.controller.payroll.records.PayrollRecordsController">
    <tabs>

        <!-- ════════════════════════════════════════════════════════
             TAB 1: صرفيات رئيسية
             ════════════════════════════════════════════════════════ -->
        <Tab closable="false" text="صرفيات رئيسية">
            <content>
                <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="1200.0" prefWidth="1280.0"
                            styleClass="app-bg">
                    <content>
                        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="card">
                            <padding>
                                <Insets bottom="16" left="16" right="16" top="16"/>
                            </padding>

                            <!-- ═══════════════════════════════════════════
                                 CARD: بيانات الموظف + البحث
                                 ═══════════════════════════════════════════ -->
                            <VBox spacing="0" styleClass="card">
                                <Label alignment="CENTER" maxWidth="Infinity" minHeight="-Infinity" prefHeight="35.0"
                                       prefWidth="1363.0" styleClass="panel-header" text="بيانات الموظف"/>
                                <HBox spacing="5.0">
                                    <children>

                                        <VBox prefHeight="152.0" prefWidth="974.0" spacing="10">
                                            <padding>
                                                <Insets bottom="12" left="12" right="12" top="12"/>
                                            </padding>

                                            <!-- Row 1: بحث + Radio buttons -->
                                            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                                                <Label prefHeight="28" styleClass="text-dark" text="بحث بـ"/>
                                                <RadioButton fx:id="rb_national_id" mnemonicParsing="false"
                                                             nodeOrientation="RIGHT_TO_LEFT" selected="true"
                                                             text="رقم قومي">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="searchGroup"/>
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="rb_emp_name" mnemonicParsing="false"
                                                             nodeOrientation="RIGHT_TO_LEFT" text="الاسم"
                                                             toggleGroup="$searchGroup"/>
                                                <RadioButton fx:id="rb_emp_code" mnemonicParsing="false"
                                                             nodeOrientation="RIGHT_TO_LEFT" text="رقم صرف"
                                                             toggleGroup="$searchGroup"/>

                                                <Separator orientation="VERTICAL"/>

                                                <TextField fx:id="txt_search" alignment="CENTER"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="200" promptText="ادخل اى قيمة للبحث"/>
                                                <Button fx:id="btn_search" defaultButton="true" prefHeight="32"
                                                        prefWidth="92.0" styleClass="btn-primary" text="🔍 بحث"/>

                                                <Region HBox.hgrow="ALWAYS"/>
                                            </HBox>

                                            <!-- Row 2: بيانات الموظف -->
                                            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                                                <Label prefHeight="28" prefWidth="58.0" styleClass="text-dark"
                                                       text="رقم قومى"/>
                                                <TextField fx:id="txt_id" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="160"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="45" styleClass="text-dark"
                                                       text="الاسم"/>
                                                <TextField fx:id="txt_name" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="235.0"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="60" styleClass="text-dark"
                                                       text="رقم صرف"/>
                                                <TextField fx:id="txt_code" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="135.0"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="50" styleClass="text-dark"
                                                       text="الدرجة"/>
                                                <TextField fx:id="txt_degree" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="120"/>
                                            </HBox>

                                            <!-- Row 3: إضافية -->
                                            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8">
                                                <Label prefHeight="28" prefWidth="50" styleClass="text-dark"
                                                       text="الادارة"/>
                                                <TextField fx:id="txt_management" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="266.0"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="50" styleClass="text-dark"
                                                       text="30-06"/>
                                                <TextField fx:id="txt_basic_30_6" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="80"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="45" styleClass="text-dark"
                                                       text="البنك"/>
                                                <TextField fx:id="txt_bank" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="140"/>
                                                <Separator orientation="VERTICAL"/>

                                                <Label prefHeight="28" prefWidth="45" styleClass="text-dark"
                                                       text="الفرع"/>
                                                <TextField fx:id="txt_branch" alignment="CENTER" editable="false"
                                                           nodeOrientation="RIGHT_TO_LEFT" prefHeight="32"
                                                           prefWidth="140"/>
                                            </HBox>

                                            <Separator/>
                                        </VBox>
                                        <Separator orientation="VERTICAL"/>
                                        <VBox prefHeight="152.0" prefWidth="288.0" spacing="10.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT"
                                                      prefHeight="28.0" prefWidth="171.0" spacing="6">
                                                    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0"
                                                           prefWidth="40.0" styleClass="text-navy" text="شهر"/>
                                                    <TextField fx:id="txt_month" alignment="CENTER"
                                                               nodeOrientation="LEFT_TO_RIGHT" prefHeight="30.0"
                                                               prefWidth="100.0" promptText="ادخل شهر"/>
                                                    <Button fx:id="btn_PDF_Review" prefHeight="30.0" prefWidth="49.0"
                                                            styleClass="btn-danger" text="PDF"/>
                                                    <Button fx:id="btn_Note" prefHeight="30.0" prefWidth="77.0"
                                                            styleClass="btn-purple" text="ملاحظات"/>
                                                </HBox>
                                                <HBox spacing="5.0">
                                                    <children>
                                                        <Label alignment="CENTER" contentDisplay="CENTER"
                                                               prefHeight="30.0" prefWidth="40.0" styleClass="text-dark"
                                                               text="من"/>
                                                        <TextField fx:id="txt_startMonth" alignment="CENTER"
                                                                   nodeOrientation="LEFT_TO_RIGHT" prefHeight="30.0"
                                                                   prefWidth="100.0" promptText="بداية السجل"/>
                                                        <Button fx:id="btn_Record" prefHeight="31.0" prefWidth="135.0"
                                                                styleClass="btn-primary" text="عرض الفترة"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="5.0">
                                                    <children>
                                                        <Label alignment="CENTER" contentDisplay="CENTER"
                                                               prefHeight="30.0" prefWidth="40.0" styleClass="text-dark"
                                                               text="الى"/>
                                                        <TextField fx:id="txt_endMonth" alignment="CENTER"
                                                                   nodeOrientation="LEFT_TO_RIGHT" prefHeight="30.0"
                                                                   prefWidth="100.0" promptText="نهاية السجل"/>
                                                        <Button fx:id="btn_PDF_Record" prefHeight="30.0"
                                                                prefWidth="56.0" styleClass="btn-danger" text="PDF"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="5.0"/>
                                            </children>
                                        </VBox>
                                        <Separator orientation="VERTICAL" prefHeight="152.0" prefWidth="0.0"/>

                                        <Region HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                            </VBox>

                            <!-- ═══════════════════════════════════════════
                                 CARD: عناصر الاستحقاقات
                                 ═══════════════════════════════════════════ -->
                            <VBox spacing="0" styleClass="card" VBox.vgrow="ALWAYS">
                                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header"
                                       text="عناصر الاستحقاقات"/>
                                <TableView fx:id="t_allowances" editable="true" maxHeight="1.7976931348623157E308"
                                           maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260"
                                           VBox.vgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="8" left="8" right="8" top="8"/>
                                    </padding>
                                </TableView>
                            </VBox>

                            <!-- ═══════════════════════════════════════════
                                 CARD: عناصر الاستقطاعات
                                 ═══════════════════════════════════════════ -->
                            <VBox spacing="0" styleClass="card" VBox.vgrow="ALWAYS">
                                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header"
                                       text="عناصر الاستقطاعات"/>
                                <TableView fx:id="t_deductions" editable="true" maxHeight="1.7976931348623157E308"
                                           maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260"
                                           VBox.vgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="8" left="8" right="8" top="8"/>
                                    </padding>
                                </TableView>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </content>
        </Tab>

        <!-- ════════════════════════════════════════════════════════
             TAB 2: صرفيات منفصلة
             ════════════════════════════════════════════════════════ -->
        <Tab closable="false" text="صرفيات منفصلة">
            <content>
                <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="1200.0" prefWidth="1280.0"
                            styleClass="app-bg">
                    <content>
                        <VBox nodeOrientation="RIGHT_TO_LEFT" prefWidth="1240.0" spacing="10" styleClass="app-bg">
                            <padding>
                                <Insets bottom="16" left="16" right="16" top="16"/>
                            </padding>

                            <!-- ═══════════════════════════════════════════
                                 CARD: Toolbar
                                 ═══════════════════════════════════════════ -->
                            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="8" styleClass="card">
                                <padding>
                                    <Insets bottom="8" left="12" right="12" top="8"/>
                                </padding>

                                <Button fx:id="btn_PDF_Review2" prefHeight="32" prefWidth="70" styleClass="btn-danger"
                                        text="PDF"/>

                                <Separator orientation="VERTICAL"/>

                                <Label prefHeight="28" prefWidth="70" styleClass="text-dark" text="شهر"/>
                                <TextField fx:id="txt_month2" prefHeight="28.0" prefWidth="135.0"/>

                                <Separator orientation="VERTICAL"/>

                                <Label prefHeight="28" prefWidth="70" styleClass="text-dark" text="الصرفية"/>
                                <TextField fx:id="txt_monthRecord" prefHeight="28.0" prefWidth="253.0"/>
                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="40.0"
                                       styleClass="text-dark" text="من"/>
                                <TextField fx:id="txt_startMonth2" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                           prefHeight="30.0" prefWidth="100.0" promptText="بداية السجل"/>
                                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="30.0" prefWidth="40.0"
                                       styleClass="text-dark" text="الى"/>
                                <TextField fx:id="txt_endMonth2" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT"
                                           prefHeight="30.0" prefWidth="100.0" promptText="نهاية السجل"/>
                                <Button fx:id="btn_Record2" prefHeight="31.0" prefWidth="114.0" styleClass="btn-primary"
                                        text="عرض الفترة"/>

                                <Region prefHeight="32.0" prefWidth="444.0" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <!-- ═══════════════════════════════════════════
                                 CARD: عناصر الاستحقاقات
                                 ═══════════════════════════════════════════ -->
                            <VBox spacing="0" styleClass="card" VBox.vgrow="ALWAYS">
                                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header"
                                       text="عناصر الاستحقاقات"/>
                                <TableView fx:id="t_allowances2" editable="true" maxHeight="1.7976931348623157E308"
                                           maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260"
                                           VBox.vgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="8" left="8" right="8" top="8"/>
                                    </padding>
                                </TableView>
                            </VBox>

                            <!-- ═══════════════════════════════════════════
                                 CARD: عناصر الاستقطاعات
                                 ═══════════════════════════════════════════ -->
                            <VBox spacing="0" styleClass="card" VBox.vgrow="ALWAYS">
                                <Label alignment="CENTER" maxWidth="Infinity" styleClass="panel-header"
                                       text="عناصر الاستقطاعات"/>
                                <TableView fx:id="t_deductions2" editable="true" maxHeight="1.7976931348623157E308"
                                           maxWidth="Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="260"
                                           VBox.vgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="8" left="8" right="8" top="8"/>
                                    </padding>
                                </TableView>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </content>
        </Tab>

    </tabs>
</TabPane>
