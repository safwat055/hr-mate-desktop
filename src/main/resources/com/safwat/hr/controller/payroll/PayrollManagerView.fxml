<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     مدير تقارير البيرول — Payroll Report Manager
     Single Screen — 3 Report Cards — Responsive Layout
     ============================================================ -->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            nodeOrientation="RIGHT_TO_LEFT" styleClass="app-bg"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.payroll.payrollManager.PayrollManagerController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="12" styleClass="card">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>

            <!-- ════════════════════════════════════════════════════════
                 HEADER
                 ════════════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="12" styleClass="card">
                <padding>
                    <Insets bottom="10" left="16" right="16" top="10"/>
                </padding>
                <Label styleClass="text-navy bold fs-18" text="مدير تقارير البيرول"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="text-secondary fs-13" text="جاهز"/>
            </HBox>

            <!-- ════════════════════════════════════════════════════════
                 ACCORDION — 3 كروت (واحد مفتوح في المرة)
                 ════════════════════════════════════════════════════════ -->
            <Accordion>
                <panes>

                    <!-- ══════════════════════════════════════════════
                         CARD 1: التقرير السنوي
                         ══════════════════════════════════════════════ -->
                    <TitledPane text="التقرير السنوي" expanded="true">
                        <content>
                            <VBox spacing="12">
                                <padding>
                                    <Insets bottom="12" left="12" right="12" top="12"/>
                                </padding>

                                <!-- ── عمليات الحذف ── -->
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label styleClass="text-navy bold fs-13" text="عمليات الحذف"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnRefreshAnnual" prefHeight="30.0" prefWidth="50.0"
                                                styleClass="btn btn-secondary" text="↻"/>
                                    </HBox>

                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="180" prefWidth="200"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="90"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                        </rowConstraints>

                                        <!-- حذف الكل -->
                                        <Label styleClass="text-dark fs-13" text="حذف كل البيانات"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <Region GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnDeleteAllAnnual" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger bold" text="حذف الكل"
                                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                                        <!-- حذف شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف شهر معين"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <TextField fx:id="txtAllMonthsYearly" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <Label fx:id="lblAllMonthsYearly" alignment="CENTER"
                                                   prefHeight="28" prefWidth="140"
                                                   styleClass="text-secondary"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteMonthAnnual" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                        <!-- حذف مجموعة في شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف مجموعة في شهر"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <TextField fx:id="txtMonthGroupY" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل الشهر"/>
                                            <TextField fx:id="txtGroupAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="250.0"
                                                       promptText="اسم المجموعة"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteGroupAnnual" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                                        <!-- حذف صرفيات موظف في شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف صرفيات موظف في شهر"
                                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <TextField fx:id="txtEmpIdAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="150.0"
                                                       promptText="الرقم القومي"/>
                                            <TextField fx:id="txtMonthForEmpAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtEmpNameAnnual" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="200.0" promptText="اسم الموظف"/>
                                            <TextField fx:id="txtEmpCodeAnnual" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="100.0" promptText="كود"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteEmpMonthAnnual" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="3"/>

                                        <!-- حذف صرفية معينة لموظف -->
                                        <Label styleClass="text-dark fs-13" text="حذف صرفية معينة لموظف"
                                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="4">
                                            <TextField fx:id="txtEmpIdPaymentAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="150.0"
                                                       promptText="الرقم القومي"/>
                                            <TextField fx:id="txtMonthForPaymentAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtPaymentNameAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="200.0"
                                                       promptText="اسم الصرفية"/>
                                            <TextField fx:id="txtEmpNameAnnual2" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="160.0" promptText="اسم الموظف"/>
                                            <TextField fx:id="txtEmpCodeAnnual2" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="100.0" promptText="كود"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeletePaymentAnnual" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                                    </GridPane>
                                </VBox>

                                <Separator/>

                                <!-- ── عمليات التعديل ── -->
                                <VBox spacing="8">
                                    <Label styleClass="text-navy bold fs-13" text="عمليات التعديل"/>

                                    <!-- تعديل اسم الصرفية -->
                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="180" prefWidth="200"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="90"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints/>
                                        </rowConstraints>

                                        <Label styleClass="text-dark fs-13"
                                               text="تعديل اسم الصرفية في كل السجلات"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <TextField fx:id="txtOldPaymentName" alignment="CENTER"
                                                       prefHeight="32" prefWidth="200.0"
                                                       promptText="الاسم القديم"/>
                                            <TextField fx:id="txtNewPaymentName" alignment="CENTER"
                                                       prefHeight="32" prefWidth="200.0"
                                                       promptText="الاسم الجديد"/>
                                        </FlowPane>
                                        <Button fx:id="btnUpdatePaymentName" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-primary bold" text="تحديث"
                                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    </GridPane>

                                    <Separator/>

                                    <!-- إضافة وصف للمجموعات -->
                                    <VBox spacing="8">
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="6"
                                                  nodeOrientation="RIGHT_TO_LEFT">
                                            <Label styleClass="text-dark fs-13"
                                                   text="إضافة وصف حسب الشهر والمجموعة"/>
                                            <TextField fx:id="txtDescMonthAnnual" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <Button fx:id="btnLoadGroupsForDesc" prefHeight="32" prefWidth="110"
                                                    styleClass="btn btn-secondary" text="عرض المجموعات"/>
                                            <Button fx:id="btnSaveDescriptions" prefHeight="32" prefWidth="110"
                                                    styleClass="btn btn-success bold" text="حفظ الأوصاف"/>
                                        </FlowPane>

                                        <TableView fx:id="tableGroupDescriptions" maxWidth="Infinity"
                                                   VBox.vgrow="ALWAYS" minHeight="200.0"
                                                   nodeOrientation="RIGHT_TO_LEFT">
                                            <columns>
                                                <TableColumn fx:id="colGroupName" prefWidth="300.0"
                                                             text="اسم المجموعة"/>
                                                <TableColumn fx:id="colGroupDesc" prefWidth="400.0"
                                                             text="الوصف"/>
                                            </columns>
                                            <padding>
                                                <Insets bottom="4" left="4" right="4" top="2"/>
                                            </padding>
                                        </TableView>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- ══════════════════════════════════════════════
                         CARD 2: تقرير المراجعة
                         ══════════════════════════════════════════════ -->
                    <TitledPane text="تقرير المراجعة">
                        <content>
                            <VBox spacing="12">
                                <padding>
                                    <Insets bottom="12" left="12" right="12" top="12"/>
                                </padding>

                                <!-- ── عمليات الحذف ── -->
                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label styleClass="text-navy bold fs-13" text="عمليات الحذف"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnRefreshReview" prefHeight="30.0" prefWidth="50.0"
                                                styleClass="btn btn-secondary" text="↻"/>
                                    </HBox>

                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="180" prefWidth="200"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="90"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                        </rowConstraints>

                                        <!-- حذف الكل -->
                                        <Label styleClass="text-dark fs-13" text="حذف كل البيانات"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <Region GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnDeleteAllReview" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger bold" text="حذف الكل"
                                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                                        <!-- حذف شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف شهر معين"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <TextField fx:id="txtMonthReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteMonthReview" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                        <!-- حذف مجموعة في شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف مجموعة في شهر"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <TextField fx:id="txtMonthForGroupReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtGroupReview" alignment="CENTER"
                                                       prefHeight="32" prefWidth="250.0"
                                                       promptText="اسم المجموعة"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteGroupReview" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="2"/>

                                        <!-- حذف صرفيات موظف في شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف صرفيات موظف في شهر"
                                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <TextField fx:id="txtEmpIdReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="150.0"
                                                       promptText="الرقم القومي"/>
                                            <TextField fx:id="txtMonthForEmpReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtEmpNameReview" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="200.0" promptText="اسم الموظف"/>
                                            <TextField fx:id="txtEmpCodeReview" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="100.0" promptText="كود"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteEmpMonthReview" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="3"/>

                                        <!-- حذف صرفية معينة لموظف -->
                                        <Label styleClass="text-dark fs-13" text="حذف صرفية معينة لموظف"
                                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="4">
                                            <TextField fx:id="txtEmpIdPaymentReview" alignment="CENTER"
                                                       prefHeight="32" prefWidth="150.0"
                                                       promptText="الرقم القومي"/>
                                            <TextField fx:id="txtMonthForPaymentReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtPaymentNameReview" alignment="CENTER"
                                                       prefHeight="32" prefWidth="200.0"
                                                       promptText="اسم الصرفية"/>
                                            <TextField fx:id="txtEmpNamePaymentReview" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="160.0" promptText="اسم الموظف"/>
                                            <TextField fx:id="txtEmpCodePaymentReview" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="100.0" promptText="كود"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeletePaymentReview" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                                    </GridPane>
                                </VBox>

                                <Separator/>

                                <!-- ── تحديث المفاتيح ── -->
                                <VBox spacing="8">
                                    <Label styleClass="text-navy bold fs-13"
                                           text="تحديث مفاتيح Nested Map"/>
                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="180" prefWidth="200"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="90"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints/>
                                        </rowConstraints>

                                        <Label styleClass="text-dark fs-13"
                                               text="تحديث تقرير المراجعة"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <TextField fx:id="txtKeyMonthReview" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="اختر شهر"/>
                                            <Button fx:id="btnUpdateKeysReview" prefHeight="32" prefWidth="104.0"
                                                    styleClass="btn btn-primary bold" text="تحديث شهر"/>
                                        </FlowPane>
                                        <Button fx:id="btnUpdateAllKeysReview" prefHeight="30.0" prefWidth="90.0"
                                                styleClass="btn btn-primary bold" text="تحديث الكل"
                                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                    </GridPane>
                                </VBox>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- ══════════════════════════════════════════════
                         CARD 3: إجر الاشتراك
                         ══════════════════════════════════════════════ -->
                    <TitledPane text="تقرير إجر الاشتراك">
                        <content>
                            <VBox spacing="12">
                                <padding>
                                    <Insets bottom="12" left="12" right="12" top="12"/>
                                </padding>

                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label styleClass="text-navy bold fs-13" text="عمليات الحذف"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="btnRefreshSub" prefHeight="30.0" prefWidth="50.0"
                                                styleClass="btn btn-secondary" text="↻"/>
                                    </HBox>

                                    <GridPane hgap="10" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="180" prefWidth="200"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                            <ColumnConstraints hgrow="NEVER" minWidth="90" prefWidth="90"/>
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                            <RowConstraints/>
                                        </rowConstraints>

                                        <!-- حذف الكل -->
                                        <Label styleClass="text-dark fs-13" text="حذف كل البيانات"
                                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <Region GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                        <Button fx:id="btnDeleteAllSub" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger bold" text="حذف الكل"
                                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                                        <!-- حذف شهر -->
                                        <Label styleClass="text-dark fs-13" text="حذف شهر معين"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <TextField fx:id="txtMonthSub" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteMonthSub" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                        <!-- حذف بيانات موظف -->
                                        <Label styleClass="text-dark fs-13" text="حذف بيانات موظف"
                                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                        <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="4"
                                                  nodeOrientation="RIGHT_TO_LEFT"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <TextField fx:id="txtEmpIdSub" alignment="CENTER"
                                                       prefHeight="32" prefWidth="150.0"
                                                       promptText="الرقم القومي"/>
                                            <TextField fx:id="txtMonthForEmpSub" alignment="CENTER"
                                                       prefHeight="30.0" prefWidth="120.0"
                                                       promptText="ادخل شهر"/>
                                            <TextField fx:id="txtEmpNameSub" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="200.0" promptText="اسم الموظف"/>
                                            <TextField fx:id="txtEmpCodeSub" alignment="CENTER"
                                                       editable="false" prefHeight="30.0"
                                                       prefWidth="100.0" promptText="كود"/>
                                        </FlowPane>
                                        <Button fx:id="btnDeleteEmpSub" prefHeight="32" prefWidth="90"
                                                styleClass="btn btn-danger" text="حذف"
                                                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                    </GridPane>
                                </VBox>
                            </VBox>
                        </content>
                    </TitledPane>

                </panes>
            </Accordion>
        </VBox>
    </content>
</ScrollPane>