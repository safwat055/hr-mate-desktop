<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    شاشة إدارة الإجازات — LeaveManagementController
    ────────────────────────────────────────────────────────────
    ① شريط البحث والأدوات (ثابت فوق)
    ② بيانات الموظف (تظهر بعد البحث)
    ③ بطاقات الرصيد
    ④ التبويبات: سجل الإجازات / أذونات التأخير / تفاصيل الرصيد
-->

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safwat.hr.controller.leave.LeaveManagementController"
            styleClass="app-bg">

    <!-- ══════════ TOP ══════════ -->
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="14" right="18" bottom="10" left="18"/>
            </padding>

            <!-- شريط البحث والأدوات -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="10" right="14" bottom="10" left="14"/>
                </padding>

                <Label styleClass="bold" text="بحث الموظف:"/>
                <TextField fx:id="employeeSearchField" prefWidth="340"
                           promptText="اسم / رقم قومي / رقم وظيفي — Enter"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label styleClass="bold" text="سنة الرصيد:"/>
                <ComboBox fx:id="yearComboBox" prefWidth="130"/>
                <Button fx:id="resetBalanceButton" text="♻️ إعادة بناء الرصيد" styleClass="btn-secondary"/>
                <Button fx:id="refreshButton" text="🔄 تحديث" styleClass="btn-secondary"/>
            </HBox>

            <!-- شريط بيانات الموظف (يظهر بعد البحث) -->
            <HBox fx:id="employeeInfoBar" spacing="14" alignment="CENTER_LEFT"
                  visible="false" managed="false" styleClass="soft-box">
                <padding>
                    <Insets top="8" right="12" bottom="8" left="12"/>
                </padding>
                <Label fx:id="employeeNameLabel" styleClass="bold fs-14"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="employeeNationalIdLabel" styleClass="text-muted fs-12"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="employeeNumberLabel" styleClass="text-muted fs-12"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="employeeGenderBadge" styleClass="bold text-navy fs-13"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════ CENTER ══════════ -->
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="6" right="18" bottom="14" left="18"/>
            </padding>

            <!-- ── بطاقات الرصيد ── -->
            <HBox spacing="12">

                <!-- اعتيادي -->
                <VBox fx:id="annualCard" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card">
                    <Label text="اعتيادي" styleClass="panel-header compact" maxWidth="Infinity"/>
                    <VBox spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="10" left="12"/>
                        </padding>
                        <Label fx:id="annualAvailableLabel" text="—" styleClass="fs-18 bold"/>
                        <Label text="الإجمالي المتاح" styleClass="text-muted fs-12"/>
                        <Separator/>
                        <GridPane hgap="10" vgap="4">
                            <Label text="مستحق السنة:" styleClass="text-muted fs-12" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="annualEntitledLabel" text="—" styleClass="fs-13" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="مستخدم:" styleClass="text-muted fs-12" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="annualUsedLabel" text="—" styleClass="fs-13" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="تأخير:" styleClass="text-muted fs-12" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="annualLateLabel" text="—" styleClass="fs-13" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="باقي:" styleClass="text-muted fs-12" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="annualRemainingLabel" text="—" styleClass="fs-13 bold" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- عارضة -->
                <VBox fx:id="casualCard" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card">
                    <Label text="عارضة" styleClass="panel-header compact success" maxWidth="Infinity"/>
                    <VBox spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="10" left="12"/>
                        </padding>
                        <Label fx:id="casualValueLabel" text="— / —" styleClass="fs-18 bold"/>
                        <Label text="مستخدم / الحد السنوي" styleClass="text-muted fs-12"/>
                        <ProgressBar fx:id="casualProgress" progress="0" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- وضع -->
                <VBox fx:id="maternityCard" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card">
                    <Label text="وضع" styleClass="panel-header compact danger" maxWidth="Infinity"/>
                    <VBox spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="10" left="12"/>
                        </padding>
                        <Label fx:id="maternityValueLabel" text="— / —" styleClass="fs-18 bold"/>
                        <Label text="مرات مستخدمة" styleClass="text-muted fs-12"/>
                    </VBox>
                </VBox>

                <!-- رعاية طفل -->
                <VBox fx:id="childCareCard" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card">
                    <Label text="رعاية طفل" styleClass="panel-header compact purple" maxWidth="Infinity"/>
                    <VBox spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="10" left="12"/>
                        </padding>
                        <Label fx:id="childCareValueLabel" text="—" styleClass="fs-18 bold"/>
                        <Label fx:id="childCareMaxLabel" text="من 6 سنوات" styleClass="text-muted fs-12"/>
                    </VBox>
                </VBox>

                <!-- إجازات مفتوحة -->
                <VBox fx:id="openEndedCard" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="card">
                    <Label text="إجازات مفتوحة" styleClass="panel-header compact alt" maxWidth="Infinity"/>
                    <VBox spacing="6">
                        <padding>
                            <Insets top="8" right="12" bottom="10" left="12"/>
                        </padding>
                        <Label fx:id="openEndedCountLabel" text="0" styleClass="fs-18 bold"/>
                        <Label text="تجنيد / استدعاء / عجز" styleClass="text-muted fs-12"/>
                        <Button fx:id="showOpenEndedButton" text="عرض" styleClass="btn-outline primary"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ── التبويبات ── -->
            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                <!-- ═══ تبويب سجل الإجازات ═══ -->
                <Tab fx:id="recordsTab" text="سجل الإجازات">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <!-- فلاتر + أزرار -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="soft-box">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="12"/>
                            </padding>

                            <Label styleClass="bold" text="النوع:"/>
                            <ComboBox fx:id="recordsTypeFilter" prefWidth="150"/>
                            <Label styleClass="bold" text="السنة:"/>
                            <ComboBox fx:id="recordsYearFilter" prefWidth="130"/>

                            <Separator orientation="VERTICAL"/>

                            <Label styleClass="bold" text="الحالة:"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <fx:define>
                                    <ToggleGroup fx:id="statusToggle"/>
                                </fx:define>
                                <RadioButton fx:id="statusAllRadio" text="الكل" selected="true" toggleGroup="$statusToggle"/>
                                <RadioButton fx:id="statusActiveRadio" text="النشطة" toggleGroup="$statusToggle"/>
                                <RadioButton fx:id="statusCancelledRadio" text="الملغاة" toggleGroup="$statusToggle"/>
                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="addRecordButton" text="➕ إضافة" styleClass="btn-primary"/>
                            <Button fx:id="editRecordButton" text="✏️ تعديل" styleClass="btn-secondary" disable="true"/>
                            <Button fx:id="closeRecordButton" text="🔒 إغلاق" styleClass="btn-secondary" disable="true"/>
                            <Button fx:id="deleteRecordButton" text="🗑️ حذف" styleClass="btn-danger" disable="true"/>
                        </HBox>

                        <!-- شريط التصدير -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="soft-box">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="12"/>
                            </padding>

                            <Label styleClass="bold" text="تصدير الإجازات"/>
                            <Label text="من:" styleClass="text-muted fs-12"/>
                            <TextField fx:id="exportFromField" prefWidth="130" promptText="yyyy-MM-dd"/>
                            <Label text="إلى:" styleClass="text-muted fs-12"/>
                            <TextField fx:id="exportToField" prefWidth="130" promptText="yyyy-MM-dd"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="exportRecordsButton" text="📤 تصدير" styleClass="btn-purple"/>
                        </HBox>

                        <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colType" text="النوع" prefWidth="160"/>
                                <TableColumn fx:id="colFrom" text="من" prefWidth="110"/>
                                <TableColumn fx:id="colTo" text="إلى" prefWidth="110"/>
                                <TableColumn fx:id="colDays" text="الأيام" prefWidth="80"/>
                                <TableColumn fx:id="colYear" text="سنة الرصيد" prefWidth="110"/>
                                <TableColumn fx:id="colStatus" text="الحالة" prefWidth="100"/>
                                <TableColumn fx:id="colNotes" text="ملاحظات" prefWidth="260"/>
                            </columns>
                            <placeholder>
                                <Label text="لا توجد سجلات" styleClass="text-muted"/>
                            </placeholder>
                        </TableView>

                        <!-- ترقيم الصفحات -->
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Label fx:id="recordsPageLabel" text="—" styleClass="text-muted fs-12"/>
                            <Button fx:id="recordsPrevButton" text="◀ السابق" styleClass="btn-secondary"/>
                            <Button fx:id="recordsNextButton" text="التالي ▶" styleClass="btn-secondary"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- ═══ تبويب أذونات التأخير ═══ -->
                <Tab fx:id="lateTab" text="أذونات التأخير">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="soft-box">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="12"/>
                            </padding>
                            <Label styleClass="bold" text="إدارة أذونات التأخير"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="addLateButton" text="➕ إضافة" styleClass="btn-primary"/>
                            <Button fx:id="editLateButton" text="✏️ تعديل" styleClass="btn-secondary" disable="true"/>
                            <Button fx:id="deleteLateButton" text="🗑️ حذف" styleClass="btn-danger" disable="true"/>
                        </HBox>

                        <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
                            <VBox spacing="4">
                                <Label text="تفاصيل الأذونات" styleClass="panel-header compact" maxWidth="Infinity"/>
                                <TableView fx:id="lateTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colLateDate" text="التاريخ" prefWidth="140"/>
                                        <TableColumn fx:id="colLateHours" text="الساعات" prefWidth="100"/>
                                        <TableColumn fx:id="colLateNotes" text="ملاحظات" prefWidth="400"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="4">
                                <Label text="الملخص الشهري — كل 6 ساعات تأخير = يوم خصم" styleClass="panel-header compact" maxWidth="Infinity"/>
                                <TableView fx:id="lateMonthTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMonth" text="الشهر" prefWidth="120"/>
                                        <TableColumn fx:id="colMonthHours" text="مجموع الساعات" prefWidth="140"/>
                                        <TableColumn fx:id="colMonthDeducted" text="أيام مخصومة" prefWidth="120"/>
                                        <TableColumn fx:id="colMonthLeftover" text="ساعات متبقية (لا تُرحَّل)" prefWidth="220"/>
                                    </columns>
                                </TableView>
                                <Label fx:id="lateTotalLabel" text="إجمالي الأيام المخصومة: —" styleClass="bold fs-12"/>
                            </VBox>
                        </SplitPane>
                    </VBox>
                </Tab>

                <!-- ═══ تبويب تفاصيل الرصيد ═══ -->
                <Tab fx:id="balanceTab" text="تفاصيل الرصيد">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="تفصيل كل السنوات من تاريخ التعيين" styleClass="panel-header compact" maxWidth="Infinity"/>

                        <TableView fx:id="balanceTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBalanceYear" text="السنة" prefWidth="130"/>
                                <TableColumn fx:id="colBalanceEntitled" text="المستحق" prefWidth="110"/>
                                <TableColumn fx:id="colBalanceUsed" text="المستخدم" prefWidth="110"/>
                                <TableColumn fx:id="colBalanceRemaining" text="المتبقي" prefWidth="110"/>
                                <TableColumn fx:id="colBalanceExpired" text="منتهي؟" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="لا توجد بيانات" styleClass="text-muted"/>
                            </placeholder>
                        </TableView>

                        <!-- ملخص السنة الحالية -->
                        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="soft-box">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="12"/>
                            </padding>
                            <Label text="السنة الحالية:" styleClass="text-muted fs-12"/>
                            <Label fx:id="balanceCurrentYearLabel" text="—" styleClass="bold fs-14"/>
                            <Separator orientation="VERTICAL"/>
                            <Label text="الشريحة:" styleClass="text-muted fs-12"/>
                            <Label fx:id="balanceTierLabel" text="—" styleClass="bold text-navy fs-14"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="الرصيد المتاح (الحالي + آخر سنتين بحد أقصى 60):" styleClass="text-muted fs-12"/>
                            <Label fx:id="balanceTotalAvailableLabel" text="—" styleClass="bold fs-16 text-navy"/>
                        </HBox>
                    </VBox>
                </Tab>

            </TabPane>
        </VBox>
    </center>
</BorderPane>