<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safwat.hr.controller.leave.LeaveRecordDialogController"
      spacing="12">

    <padding>
        <Insets top="16" right="18" bottom="16" left="18"/>
    </padding>

    <Label fx:id="employeeLabel" styleClass="bold fs-14"/>

    <Separator/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>

        <Label text="النوع:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="leaveTypeCombo" maxWidth="Infinity"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="من تاريخ:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="fromDateField" promptText="yyyy-MM-dd"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label fx:id="toDateLabel" text="إلى تاريخ:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="toDateField" promptText="yyyy-MM-dd"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label fx:id="openEndedHint" text="النهاية تُضاف عند العودة"
               GridPane.rowIndex="2" GridPane.columnIndex="1"
               visible="false" managed="false" styleClass="text-muted fs-12"/>

        <Label text="عدد الأيام:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="daysPreviewLabel" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1"
               styleClass="fs-16 bold text-navy"/>

        <Label text="ملاحظات:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="warningLabel" text="" visible="false" managed="false"
           styleClass="text-danger bold fs-13" wrapText="true"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="إلغاء" styleClass="btn-secondary"/>
        <Button fx:id="saveButton" text="حفظ" styleClass="btn-primary"/>
    </HBox>
</VBox>