<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    حوار إضافة / تعديل سجل إجازة — LeaveRecordDialogController
    ────────────────────────────────────────────────────────────
    ① اسم الموظف (عنوان)
    ② نوع الإجازة والتواريخ وعدد الأيام
    ③ تنبيهات (الإجازات المفتوحة + التحذيرات)
    ④ الملاحظات
    ⑤ أزرار الحفظ والإلغاء
-->

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safwat.hr.controller.leave.LeaveRecordDialogController"
      nodeOrientation="RIGHT_TO_LEFT"
      spacing="14"
      styleClass="app-bg"
      prefWidth="500">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <!-- ══════════ ① اسم الموظف ══════════ -->
    <VBox styleClass="card">
        <Label fx:id="employeeLabel" styleClass="panel-header" maxWidth="Infinity" text="سجل إجازة"/>
    </VBox>

    <!-- ══════════ ② بيانات الإجازة ══════════ -->
    <VBox spacing="12" styleClass="card">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>

        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
            </columnConstraints>

            <Label styleClass="form-label" text="النوع:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="leaveTypeCombo" maxWidth="Infinity" prefHeight="36"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label styleClass="form-label" text="من تاريخ:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="fromDateField" promptText="yyyy-MM-dd" prefHeight="36" maxWidth="Infinity"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label fx:id="toDateLabel" styleClass="form-label" text="إلى تاريخ:"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="toDateField" promptText="yyyy-MM-dd" prefHeight="36" maxWidth="Infinity"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label styleClass="form-label" text="عدد الأيام:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <HBox alignment="CENTER_LEFT" styleClass="soft-box"
                  GridPane.rowIndex="3" GridPane.columnIndex="1">
                <padding>
                    <Insets top="6" right="12" bottom="6" left="12"/>
                </padding>
                <Label fx:id="daysPreviewLabel" text="—" styleClass="fs-16 bold text-navy"/>
            </HBox>

            <Label styleClass="form-label" text="ملاحظات:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="notesArea" prefRowCount="3" wrapText="true" maxWidth="Infinity"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- ══════════ ③ تنبيهات ══════════ -->
    <!-- الإرشادي: يظهر لما يكون في إجازة مفتوحة -->
    <Label fx:id="openEndedHint" text="" visible="false" managed="false"
           styleClass="soft-box text-muted fs-12" wrapText="true" maxWidth="Infinity"/>

    <!-- التحذير: يظهر عند وجود خطأ أو تعارض -->
    <Label fx:id="warningLabel" text="" visible="false" managed="false"
           styleClass="text-danger bold fs-13" wrapText="true" maxWidth="Infinity"/>

    <!-- ══════════ ④ الأزرار ══════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="إلغاء" styleClass="btn-secondary" prefHeight="38" prefWidth="110"/>
        <Button fx:id="saveButton" text="حفظ" styleClass="btn-primary" prefHeight="38" prefWidth="110"/>
    </HBox>
</VBox>