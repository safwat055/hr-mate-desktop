<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox nodeOrientation="RIGHT_TO_LEFT" spacing="10" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.safwat.hr.controller.wages.ui.VariableWageDocumentsTableController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-weight: bold;" text="سجلات الموظف" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="addButton" disable="true" text="+ إضافة مستند" />
    </HBox>

    <TableView fx:id="table" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="monthColumn" prefWidth="90" text="الشهر" />
            <TableColumn fx:id="nameColumn" prefWidth="160" text="اسم المستند" />
            <TableColumn fx:id="numberColumn" prefWidth="110" text="رقم الشطب" />
            <TableColumn fx:id="totalColumn" prefWidth="100" text="الإجمالي" />
            <TableColumn fx:id="pensionColumn" prefWidth="100" text="خاضع معاشات" />
            <TableColumn fx:id="taxColumn" prefWidth="100" text="خاضع ضريبة" />
            <TableColumn fx:id="actionsColumn" prefWidth="70" text="" />
        </columns>
    </TableView>
</VBox>
