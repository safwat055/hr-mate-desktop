<?xml version="1.0" encoding="UTF-8"?>

<!--
    شاشة البدلات — AllowanceView.fxml
    ────────────────────────────────────────────────────────────
    تاب 1: بيانات الموظف (عرض فقط — مجلوبة من محرك الراتب)
    تاب 2: جدول البدلات (إضافة / تعديل / حذف / reset) — بيعرض اسم
           البدل بالعربي وقيمته بعد الاحتساب لكل بدل.

    مساحات أوسع من النسخة القديمة (padding/spacing أكبر، حقول وأزرار
    أعلى) عشان العناصر متبقاش حاسس إنها داخلة في بعض.
-->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane
        fitToHeight="true"
        fitToWidth="true"
        nodeOrientation="RIGHT_TO_LEFT"
        styleClass="app-bg"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.safwat.hr.controller.allowance.AllowanceFxController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="18" styleClass="card">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18"/>
            </padding>

            <!-- ══════════════════════════════════════════════════
                 1. شريط البحث
            ══════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_RIGHT" spacing="14" styleClass="card">
                <padding>
                    <Insets bottom="14" left="16" right="16" top="14"/>
                </padding>

                <Button fx:id="btn_search"
                        prefHeight="38" prefWidth="100"
                        styleClass="btn-primary"
                        text="🔍 بحث"/>

                <Label prefWidth="90" styleClass="bold" text="الرقم القومي"/>
                <TextField fx:id="txt_nationalId"
                           alignment="CENTER"
                           prefHeight="38" prefWidth="190"
                           promptText="أدخل الرقم القومي"/>

                <Separator orientation="VERTICAL"/>

                <!-- مؤشر تحميل -->
                <ProgressIndicator fx:id="progress_indicator"
                                   prefHeight="26" prefWidth="26"
                                   visible="false"/>

                <!-- رسالة خطأ -->
                <Label fx:id="lbl_error"
                       styleClass="text-danger bold"
                       visible="false"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- زر إدارة قواعد البدلات — متاح دايماً، مش محتاج بحث عن موظف -->
                <Button fx:id="btn_manageDefinitions"
                        prefHeight="38" prefWidth="150"
                        styleClass="btn-purple"
                        text="⚙ قواعد البدلات"/>

                <!-- زر Reset — يظهر بعد تحميل الموظف -->
                <Button fx:id="btn_reset"
                        prefHeight="38" prefWidth="130"
                        styleClass="btn-danger"
                        text="🔄 إعادة الضبط"
                        visible="false"/>
            </HBox>

            <!-- ══════════════════════════════════════════════════
                 2. TabPane الرئيسي
            ══════════════════════════════════════════════════ -->
            <TabPane fx:id="main_tabs"
                     VBox.vgrow="ALWAYS"
                     tabClosingPolicy="UNAVAILABLE"
                     tabMinHeight="42">

                <!-- ─── تاب 1: بيانات الموظف ─────────────────── -->
                <Tab text="بيانات الموظف">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="app-bg">
                            <content>
                                <VBox spacing="18" nodeOrientation="RIGHT_TO_LEFT">
                                    <padding>
                                        <Insets bottom="18" left="18" right="18" top="18"/>
                                    </padding>

                                    <!-- بيانات أساسية -->
                                    <VBox styleClass="card" spacing="0">
                                        <Label alignment="CENTER" maxWidth="Infinity"
                                               styleClass="panel-header compact"
                                               text="البيانات الأساسية"/>
                                        <HBox spacing="30" nodeOrientation="RIGHT_TO_LEFT">
                                            <padding>
                                                <Insets bottom="18" left="18" right="18" top="16"/>
                                            </padding>

                                            <!-- عمود 1 -->
                                            <VBox spacing="14" minWidth="270">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="اسم الموظف"/>
                                                    <TextField fx:id="txt_empName"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"
                                                               styleClass="text-field"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="الرقم القومي"/>
                                                    <TextField fx:id="txt_empNationalId"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="كود الوظيفة"/>
                                                    <TextField fx:id="txt_empLawCode"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                            </VBox>

                                            <Separator orientation="VERTICAL"/>

                                            <!-- عمود 2 -->
                                            <VBox spacing="14" minWidth="270">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="القانون"/>
                                                    <TextField fx:id="txt_empLaw"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="تاريخ التعيين"/>
                                                    <TextField fx:id="txt_empStartDate"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="الدرجة الحالية"/>
                                                    <TextField fx:id="txt_empDegree"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                            </VBox>

                                            <Separator orientation="VERTICAL"/>

                                            <!-- عمود 3 -->
                                            <VBox spacing="14" minWidth="270">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="الأساسي 30/6"/>
                                                    <TextField fx:id="txt_empBasic30"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="من تاريخ"/>
                                                    <TextField fx:id="txt_empBasic30From"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold" text="المجموعة"/>
                                                    <TextField fx:id="txt_empGroup"
                                                               prefHeight="34" prefWidth="180"
                                                               editable="false"/>
                                                </HBox>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                    <!-- ملاحظة -->
                                    <Label styleClass="text-muted fs-12"
                                           text="* البيانات محسوبة من محرك الراتب — للتعديل روح لشاشة السلم الوظيفي"/>

                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ─── تاب 2: البدلات ────────────────────────── -->
                <Tab text="البدلات">
                    <content>
                        <VBox spacing="16" nodeOrientation="RIGHT_TO_LEFT">
                            <padding>
                                <Insets bottom="18" left="18" right="18" top="18"/>
                            </padding>

                            <!-- شريط أدوات البدلات -->
                            <HBox alignment="CENTER_RIGHT" spacing="14" styleClass="card">
                                <padding>
                                    <Insets bottom="14" left="16" right="16" top="14"/>
                                </padding>

                                <!-- تاريخ الاحتساب -->
                                <Label styleClass="bold" text="تاريخ الاحتساب"/>
                                <DatePicker fx:id="date_calculation"
                                            prefHeight="38" prefWidth="170"
                                            promptText="اختر تاريخ"/>

                                <Button fx:id="btn_recalculate"
                                        prefHeight="38" prefWidth="110"
                                        styleClass="btn-purple"
                                        text="⚙ احتساب"/>

                                <Separator orientation="VERTICAL"/>

                                <!-- إضافة بدل جديد -->
                                <Label styleClass="bold" text="إضافة بدل"/>
                                <ComboBox fx:id="combo_newAllowance"
                                          prefHeight="38" prefWidth="210"
                                          promptText="اختر بدل..."/>
                                <Button fx:id="btn_addAllowance"
                                        prefHeight="38" prefWidth="95"
                                        styleClass="btn-success"
                                        text="+ إضافة"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <!-- إجمالي -->
                                <Label styleClass="bold text-navy fs-14" text="الإجمالي:"/>
                                <Label fx:id="lbl_total"
                                       styleClass="bold fs-14 text-success"
                                       text="0.00 ج"/>
                            </HBox>

                            <!-- جدول البدلات الرئيسي — اسم البدل بالعربي + القيمة بعد الاحتساب -->
                            <TableView fx:id="table_allowances"
                                       nodeOrientation="RIGHT_TO_LEFT"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="440"
                                       styleClass="bold">
                                <columns>
                                    <TableColumn fx:id="col_nameAr"
                                                 text="اسم البدل"
                                                 prefWidth="260"/>
                                    <TableColumn fx:id="col_value"
                                                 text="القيمة بعد الاحتساب (ج)"
                                                 prefWidth="180"/>
                                    <TableColumn fx:id="col_effectiveFrom"
                                                 text="من تاريخ"
                                                 prefWidth="140"/>
                                    <TableColumn fx:id="col_source"
                                                 text="المصدر"
                                                 prefWidth="120"/>
                                    <TableColumn fx:id="col_actions"
                                                 text="إجراءات"
                                                 prefWidth="190"/>
                                </columns>
                                <padding>
                                    <Insets bottom="8" left="8" right="8" top="6"/>
                                </padding>
                            </TableView>

                        </VBox>
                    </content>
                </Tab>

            </TabPane>

        </VBox>
    </content>
</ScrollPane>
