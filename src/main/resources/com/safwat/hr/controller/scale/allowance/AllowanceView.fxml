<?xml version="1.0" encoding="UTF-8"?>

<!--
    شاشة البدلات — AllowanceView.fxml
    ────────────────────────────────────────────────────────────
    تاب 1: بيانات الموظف (عرض فقط — مجلوبة من محرك الراتب)
    تاب 2: جدول البدلات (إضافة / تعديل / حذف / reset)

    جدول البدلات بيستخدم:
      - col_elementType : عمود النوع (استحقاق / استقطاع / تأمينات / ضريبة / دمغة)
      - col_value       : القيمة المطلقة (abs) — اللون حسب النوع
      - col_source      : مصدر القيمة (تلقائي / يدوي / مستثنى)
-->

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToHeight="true" fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" styleClass="app-bg"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.allowance.AllowanceFxController">

    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="18" styleClass="card">
            <padding>
                <Insets bottom="18" left="18" right="18" top="18"/>
            </padding>

            <!-- ══════════════════════════════════════════════════
                 1. شريط البحث
            ══════════════════════════════════════════════════ -->
            <HBox alignment="CENTER_RIGHT" spacing="14" styleClass="card">
                <padding>
                    <Insets bottom="14" left="16" right="16" top="14"/>
                </padding>

                <Button fx:id="btn_search" prefHeight="38" prefWidth="100"
                        styleClass="btn-primary" text="🔍 بحث"/>

                <Label prefWidth="90" styleClass="bold" text="الرقم القومي"/>
                <TextField fx:id="txt_nationalId" alignment="CENTER" prefHeight="38" prefWidth="190"
                           promptText="أدخل الرقم القومي"/>

                <Separator orientation="VERTICAL"/>

                <ProgressIndicator fx:id="progress_indicator" prefHeight="26" prefWidth="26"
                                   visible="false"/>

                <Label fx:id="lbl_error" styleClass="text-danger bold" visible="false"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btn_statutory" prefHeight="38" prefWidth="160"
                        styleClass="btn-purple" text="⚙ تامينات وضرايب"/>

                <Button fx:id="btn_manageDefinitions" prefHeight="38" prefWidth="150"
                        styleClass="btn-purple" text="⚙ قواعد البدلات"/>

                <Button fx:id="btn_reset" prefHeight="38" prefWidth="130"
                        styleClass="btn-danger" text="🔄 إعادة الضبط" visible="false"/>
            </HBox>

            <!-- ══════════════════════════════════════════════════
                 2. TabPane الرئيسي
            ══════════════════════════════════════════════════ -->
            <TabPane fx:id="main_tabs" tabClosingPolicy="UNAVAILABLE" tabMinHeight="42"
                     VBox.vgrow="ALWAYS">

                <!-- ─── تاب 1: بيانات الموظف ─────────────────── -->
                <Tab text="بيانات الموظف">
                    <content>
                        <ScrollPane fitToWidth="true" styleClass="app-bg">
                            <content>
                                <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="18">
                                    <padding>
                                        <Insets bottom="18" left="18" right="18" top="18"/>
                                    </padding>

                                    <VBox spacing="0" styleClass="card">
                                        <Label alignment="CENTER" maxWidth="Infinity"
                                               styleClass="panel-header compact"
                                               text="البيانات الأساسية"/>
                                        <HBox nodeOrientation="RIGHT_TO_LEFT" spacing="30">
                                            <padding>
                                                <Insets bottom="18" left="18" right="18" top="16"/>
                                            </padding>

                                            <!-- عمود 1 -->
                                            <VBox minWidth="270" spacing="14">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="اسم الموظف"/>
                                                    <TextField fx:id="txt_empName" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="الرقم القومي"/>
                                                    <TextField fx:id="txt_empNationalId" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="كود الوظيفة"/>
                                                    <TextField fx:id="txt_empLawCode" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                            </VBox>

                                            <Separator orientation="VERTICAL"/>

                                            <!-- عمود 2 -->
                                            <VBox minWidth="270" spacing="14">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="القانون"/>
                                                    <TextField fx:id="txt_empLaw" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="تاريخ التعيين"/>
                                                    <TextField fx:id="txt_empStartDate" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="الدرجة الحالية"/>
                                                    <TextField fx:id="txt_empDegree" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                            </VBox>

                                            <Separator orientation="VERTICAL"/>

                                            <!-- عمود 3 -->
                                            <VBox minWidth="270" spacing="14">
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="الأساسي 30/6"/>
                                                    <TextField fx:id="txt_empBasic30" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="من تاريخ"/>
                                                    <TextField fx:id="txt_empBasic30From" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                                    <Label prefWidth="105" styleClass="bold"
                                                           text="المجموعة"/>
                                                    <TextField fx:id="txt_empGroup" editable="false"
                                                               prefHeight="34" prefWidth="180"/>
                                                </HBox>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                    <Label styleClass="text-muted fs-12"
                                           text="* البيانات محسوبة من محرك الراتب — للتعديل روح لشاشة السلم الوظيفي"/>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ─── تاب 2: البدلات ────────────────────────── -->
                <Tab text="البدلات">
                    <content>
                        <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="16">
                            <padding>
                                <Insets bottom="18" left="18" right="18" top="18"/>
                            </padding>

                            <!-- شريط أدوات البدلات -->
                            <HBox alignment="CENTER_RIGHT" spacing="14" styleClass="card">
                                <padding>
                                    <Insets bottom="14" left="16" right="16" top="14"/>
                                </padding>

                                <Label styleClass="bold" text="تاريخ الاحتساب"/>
                                <DatePicker fx:id="date_calculation" prefHeight="38" prefWidth="170"
                                            promptText="اختر تاريخ"/>

                                <Button fx:id="btn_recalculate" prefHeight="38" prefWidth="110"
                                        styleClass="btn-purple" text="⚙ احتساب"/>

                                <Separator orientation="VERTICAL"/>

                                <Label styleClass="bold" text="إضافة بدل"/>
                                <ComboBox fx:id="combo_newAllowance" prefHeight="38" prefWidth="210"
                                          promptText="اختر بدل..."/>
                                <Button fx:id="btn_addAllowance" prefHeight="38" prefWidth="95"
                                        styleClass="btn-success" text="+ إضافة"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label styleClass="bold text-navy fs-14" text="الصافي:"/>
                                <Label fx:id="lbl_total" styleClass="bold fs-14 text-success"
                                       text="0.00 ج"/>
                            </HBox>

                            <!-- جدول البدلات الرئيسي -->
                            <TableView fx:id="table_allowances" nodeOrientation="RIGHT_TO_LEFT"
                                       prefHeight="440" styleClass="bold" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="col_nameAr" prefWidth="230" text="اسم البدل"/>
                                    <TableColumn fx:id="col_elementType" prefWidth="110" text="النوع"/>
                                    <TableColumn fx:id="col_value" prefWidth="140" text="القيمة (ج)"/>
                                    <TableColumn fx:id="col_effectiveFrom" prefWidth="120" text="من تاريخ"/>
                                    <TableColumn fx:id="col_source" prefWidth="110" text="المصدر"/>
                                    <TableColumn fx:id="col_actions" prefWidth="170" text="إجراءات"/>
                                </columns>
                                <padding>
                                    <Insets bottom="8" left="8" right="8" top="6"/>
                                </padding>
                            </TableView>

                        </VBox>
                    </content>
                </Tab>

            </TabPane>

        </VBox>
    </content>
</ScrollPane>