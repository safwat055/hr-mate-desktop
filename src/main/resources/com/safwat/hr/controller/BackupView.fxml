<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="790.0" prefWidth="955.0" styleClass="stg-backup-root"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.backup.BackupController">

    <!-- ═══ Header ═══ -->
    <top>
        <VBox styleClass="stg-page-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="stg-header-icon" text="💾"/>
                <VBox spacing="2">
                    <Label styleClass="stg-page-title" text="النسخ الاحتياطي والاستعادة"/>
                    <Label styleClass="stg-page-subtitle" text="إدارة نسخ قاعدة البيانات بأمان"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="statusChip" alignment="CENTER" spacing="6" styleClass="stg-status-chip">
                    <Label fx:id="statusDot" styleClass="stg-status-dot-ok" text="●"/>
                    <Label fx:id="statusLabel" styleClass="stg-status-text" text="متصل"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ═══ Main Content ═══ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="1119.0" prefWidth="955.0"
                    styleClass="stg-main-scroll">
            <VBox spacing="20" styleClass="stg-main-content">

                <!-- ─── الصف الأول: نسخ + استعادة سريعة ─── -->
                <HBox alignment="TOP_LEFT" spacing="16">

                    <!-- ┌─ بطاقة النسخ الكامل ─┐ -->
                    <VBox spacing="0" styleClass="stg-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                            <Label styleClass="stg-card-icon" text="🗄"/>
                            <Label styleClass="stg-card-title" text="نسخ احتياطي كامل"/>
                        </HBox>
                        <VBox spacing="14" styleClass="stg-card-body">
                            <Label styleClass="stg-card-description"
                                   text="ينسخ قاعدة البيانات كاملة بصيغة Custom Format (مضغوطة)." wrapText="true"/>

                            <VBox spacing="8">
                                <Label styleClass="stg-field-label" text="صيغة الملف"/>
                                <HBox spacing="10">
                                    <RadioButton fx:id="radioCustomFormat" selected="true" styleClass="stg-radio-opt"
                                                 text="Custom (.dump) — موصى به"/>
                                    <RadioButton fx:id="radioPlainFormat" styleClass="stg-radio-opt"
                                                 text="Plain SQL (.sql)"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="stg-field-label" text="مستوى الضغط (0 = بلا ضغط، 9 = أقصى)"/>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Slider fx:id="compressionSlider" blockIncrement="1" majorTickUnit="3" max="9"
                                            min="0" minorTickCount="2" showTickLabels="true" showTickMarks="true"
                                            snapToTicks="true" value="6" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                            <Label fx:id="compressionValueLabel" maxWidth="1.7976931348623157E308" prefHeight="27.0"
                                   prefWidth="381.0" styleClass="stg-slider-value" text="6"/>

                            <Button fx:id="btnBackup" maxWidth="Infinity" onAction="#handleFullBackup"
                                    styleClass="stg-btn-primary" text="▶  بدء النسخ الاحتياطي"/>

                            <ProgressBar fx:id="backupProgress" maxWidth="Infinity" progress="-1"
                                         styleClass="stg-progress-bar-hidden"/>
                            <Label fx:id="backupStatusLabel" styleClass="stg-status-msg" text="" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- ┌─ بطاقة الاستعادة من ملف مرفوع ─┐ -->
                    <VBox prefHeight="334.0" prefWidth="380.0" spacing="0" styleClass="stg-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                            <Label styleClass="stg-card-icon" text="📤"/>
                            <Label styleClass="stg-card-title" text="استعادة من ملف"/>
                        </HBox>
                        <VBox prefHeight="316.0" prefWidth="421.0" spacing="14" styleClass="stg-card-body">
                            <Label styleClass="stg-card-description"
                                   text="ارفع ملف نسخة احتياطية (.dump أو .sql) لاستعادته." wrapText="true"/>

                            <VBox spacing="6">
                                <Label styleClass="stg-field-label" text="ملف النسخة الاحتياطية"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <TextField fx:id="uploadFilePath" editable="false" promptText="لم يتم اختيار ملف..."
                                               styleClass="stg-file-field" HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#handleChooseFile" styleClass="stg-btn-secondary"
                                            text="اختر ملف"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="stg-field-label" text="وضع الاستعادة"/>
                                <VBox spacing="6" styleClass="stg-mode-box">
                                    <RadioButton fx:id="radioReplace" selected="true" styleClass="stg-radio-opt"
                                                 text="استبدال كامل"/>
                                    <Label styleClass="stg-radio-hint"
                                           text="يمسح البيانات الحالية ثم يعيد كتابتها من النسخة. آمن ونظيف."
                                           wrapText="true"/>
                                    <RadioButton fx:id="radioMerge" styleClass="stg-radio-opt"
                                                 text="كتابة فوق الموجود (Merge)"/>
                                    <Label styleClass="stg-radio-hint,stg-radio-hint-warn"
                                           text="يضيف البيانات فوق الموجودة. قد يسبب تعارضاً في المفاتيح."
                                           wrapText="true"/>
                                </VBox>
                            </VBox>

                            <Button fx:id="btnRestoreFile" disable="true" maxWidth="Infinity"
                                    onAction="#handleRestoreFromFile" styleClass="stg-btn-danger"
                                    text="⬆  استعادة من الملف"/>

                            <ProgressBar fx:id="restoreFileProgress" maxWidth="Infinity" progress="-1"
                                         styleClass="stg-progress-bar-hidden"/>
                            <Label fx:id="restoreFileStatusLabel" styleClass="stg-status-msg" text="" wrapText="true"/>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- ─── الصف الثاني: النسخ المحلية ─── -->
                <VBox spacing="0" styleClass="stg-card">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                        <Label styleClass="stg-card-icon" text="📁"/>
                        <Label styleClass="stg-card-title" text="النسخ المحفوظة محلياً"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="backupsCountLabel" styleClass="stg-count-label" text="0 نسخة"/>
                        <Button onAction="#handleRefreshBackups" styleClass="stg-btn-ghost" text="↻  تحديث"/>
                    </HBox>
                    <VBox spacing="12" styleClass="stg-card-body">

                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label styleClass="stg-field-label" text="وضع الاستعادة:"/>
                            <RadioButton fx:id="radioLocalReplace" selected="true" styleClass="stg-radio-opt"
                                         text="استبدال كامل"/>
                            <RadioButton fx:id="radioLocalMerge" styleClass="stg-radio-opt" text="Merge"/>
                        </HBox>

                        <ListView fx:id="backupsListView" minHeight="120" prefHeight="260"
                                  styleClass="stg-backups-list-view"/>

                        <Label fx:id="restoreLocalStatusArea" maxWidth="Infinity" minHeight="50" prefHeight="60"
                               styleClass="stg-status-area-label" wrapText="true"/>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="btnRestoreSelected" disable="true" onAction="#handleRestoreSelected"
                                    styleClass="stg-btn-danger" text="⬇  استعادة النسخة المحددة"/>
                            <ProgressBar fx:id="restoreLocalProgress" maxWidth="200" progress="-1"
                                         styleClass="stg-progress-bar-hidden"/>
                        </HBox>

                    </VBox>
                </VBox>

                <!-- ─── الصف الثالث: النسخ التلقائي ─── -->
                <VBox spacing="0" styleClass="stg-card">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                        <Label styleClass="stg-card-icon" text="⏱"/>
                        <Label styleClass="stg-card-title" text="النسخ التلقائي"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="toggleAutoBackup" onAction="#handleToggleAutoBackup"
                                      styleClass="stg-toggle-btn" text="غير مفعّل"/>
                    </HBox>
                    <VBox spacing="14" styleClass="stg-card-body">
                        <Label styleClass="stg-card-description"
                               text="يتم النسخ تلقائياً وفق الجدول المحدد. التغييرات تُطبَّق فور إعادة تشغيل الخادم."
                               wrapText="true"/>

                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label minWidth="160" styleClass="stg-field-label" text="Cron expression:"/>
                            <TextField fx:id="cronField" prefWidth="160" styleClass="stg-cron-field"
                                       text="0 0 2 * * ?"/>
                            <Label fx:id="cronHintLabel" styleClass="stg-cron-hint" text="كل يوم الساعة 2:00 صباحاً"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label minWidth="160" styleClass="stg-field-label" text="اختيار سريع:"/>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="يومي"
                                        userData="0 0 2 * * ?"/>
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="يومين"
                                        userData="0 0 2 */2 * ?"/>
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="3 أيام"
                                        userData="0 0 2 */3 * ?"/>
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="5 أيام"
                                        userData="0 0 2 */5 * ?"/>
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="أسبوعي"
                                        userData="0 0 2 */7 * ?"/>
                                <Button onAction="#handleCronPreset" styleClass="stg-btn-cron-preset" text="شهري"
                                        userData="0 0 2 1 * ?"/>
                            </HBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <Label minWidth="160" styleClass="stg-field-label" text="أقصى عدد نسخ محفوظة:"/>
                            <Spinner fx:id="maxFilesSpinner" editable="true" initialValue="7" max="30" min="1"
                                     prefWidth="80" styleClass="stg-spinner-light"/>
                            <Label styleClass="stg-field-hint" text="نسخة (الأقدم يُحذف تلقائياً)"/>
                        </HBox>

                        <Button onAction="#handleSaveAutoBackupSettings" prefWidth="220" styleClass="stg-btn-secondary"
                                text="حفظ إعدادات النسخ التلقائي"/>

                        <Label fx:id="autoBackupStatusLabel" styleClass="stg-status-msg" text="" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- ─── الصف الرابع: تنفيذ سكريبتات SQL ─── -->
                <VBox spacing="0" styleClass="stg-card">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                        <Label styleClass="stg-card-icon" text="⚙"/>
                        <Label styleClass="stg-card-title" text="تنفيذ سكريبتات قاعدة البيانات (Admin)"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="stg-count-label" text="للأدمن فقط"/>
                    </HBox>
                    <VBox spacing="12" styleClass="stg-card-body">
                        <Label styleClass="stg-card-description"
                               text="ارفع ملف SQL موقّع لينفذ على قاعدة البيانات (إضافة / حذف / تعديل / إعادة هيكلة). يجب أن يحتوي الملف على التوقيع في أول سطر وآخر سطر."
                               wrapText="true"/>

                        <VBox spacing="6">
                            <Label styleClass="stg-field-label" text="ملف SQL"/>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <TextField fx:id="sqlFilePath" editable="false" promptText="لم يتم اختيار ملف..."
                                           styleClass="stg-file-field" HBox.hgrow="ALWAYS"/>
                                <Button onAction="#handleChooseSqlFile" styleClass="stg-btn-secondary" text="اختر ملف"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="6" styleClass="stg-mode-box">
                            <CheckBox fx:id="chkStopOnError" selected="true" styleClass="stg-radio-opt"
                                      text="إيقاف التنفيذ والتراجع عن كل التغييرات عند أي خطأ (موصى به)"/>
                            <Label styleClass="stg-radio-hint"
                                   text="لو الاختيار مفعّل: أي خطأ في أي أمر يرجع قاعدة البيانات لحالتها قبل السكريبت (Rollback)."
                                   wrapText="true"/>
                            <Label styleClass="stg-radio-hint,stg-radio-hint-warn"
                                   text="⚠ نصيحة: نفّذ نسخة احتياطية قبل تشغيل أي سكريبت يعدّل الهيكل أو يحذف بيانات."
                                   wrapText="true"/>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="btnValidateScript" disable="true" onAction="#handleValidateScript"
                                    styleClass="stg-btn-secondary" text="🔍 فحص التوقيع"/>
                            <Button fx:id="btnExecuteScript" disable="true" onAction="#handleExecuteScript"
                                    styleClass="stg-btn-danger" text="▶ تنفيذ السكريبت"/>
                            <ProgressBar fx:id="scriptProgress" maxWidth="200" progress="-1"
                                         styleClass="stg-progress-bar-hidden"/>
                        </HBox>

                        <Label fx:id="scriptStatusLabel" styleClass="stg-status-msg" text="" wrapText="true"/>

                        <Label fx:id="scriptResultArea" maxWidth="Infinity" minHeight="60" prefHeight="140"
                               styleClass="stg-status-area-label" wrapText="true"/>
                    </VBox>
                </VBox>
                <!-- ─── الصف الخامس: تصدير جدول ─── -->
                <VBox spacing="0" styleClass="stg-card">
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="stg-card-header">
                        <Label styleClass="stg-card-icon" text="📤"/>
                        <Label styleClass="stg-card-title" text="تصدير جدول قاعدة البيانات (Admin)"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label styleClass="stg-count-label" text="للأدمن فقط"/>
                    </HBox>
                    <VBox spacing="12" styleClass="stg-card-body">

                        <Label styleClass="stg-card-description"
                               text="يصدّر جدولاً واحداً إلى ملف SQL موقّع يمكن استيراده على جهاز آخر عبر أداة تنفيذ السكريبتات."
                               wrapText="true"/>

                        <!-- اختيار الـ Schema والجدول -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label minWidth="120" styleClass="stg-field-label" text="Schema:"/>
                            <ComboBox fx:id="combo_schema" prefWidth="220"
                                      promptText="اختر schema..." HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRefreshSchemas" onAction="#handleRefreshSchemas"
                                    styleClass="stg-btn-ghost" text="↻ تحديث"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label minWidth="120" styleClass="stg-field-label" text="الجدول:"/>
                            <ComboBox fx:id="combo_table" prefWidth="220"
                                      promptText="اختر جدولاً..." HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnPreviewTable" disable="true"
                                    onAction="#handlePreviewTable"
                                    styleClass="stg-btn-secondary" text="🔍 معاينة"/>
                        </HBox>

                        <!-- وضع التصدير -->
                        <VBox spacing="6" styleClass="stg-mode-box">
                            <Label styleClass="stg-field-label" text="وضع التصدير:"/>
                            <RadioButton fx:id="radioExportReplace" selected="true"
                                         styleClass="stg-radio-opt"
                                         text="استبدال كامل (REPLACE)"/>
                            <Label styleClass="stg-radio-hint"
                                   text="عند الاستيراد: سيتم TRUNCATE الجدول أولاً ثم إدخال البيانات الجديدة."
                                   wrapText="true"/>
                            <RadioButton fx:id="radioExportMerge" styleClass="stg-radio-opt"
                                         text="دمج (MERGE)"/>
                            <Label styleClass="stg-radio-hint,stg-radio-hint-warn"
                                   text="عند الاستيراد: سيتم تحديث السجلات الموجودة (حسب الـ PK) وإضافة الجديدة."
                                   wrapText="true"/>
                        </VBox>

                        <!-- معلومات الجدول (معاينة) -->
                        <VBox spacing="6">
                            <Label styleClass="stg-field-label" text="معلومات الجدول:"/>
                            <Label fx:id="tableInfoArea" maxWidth="Infinity" minHeight="60"
                                   prefHeight="140" styleClass="stg-status-area-label"
                                   wrapText="true"/>
                        </VBox>

                        <!-- أزرار التنفيذ -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="btnExportTable" disable="true"
                                    onAction="#handleExportTable"
                                    styleClass="stg-btn-primary"
                                    text="⬇  تصدير الجدول إلى ملف SQL"/>
                            <ProgressBar fx:id="exportProgress" maxWidth="200" progress="-1"
                                         styleClass="stg-progress-bar-hidden"/>
                        </HBox>

                        <Label fx:id="exportStatusLabel" styleClass="stg-status-msg"
                               text="" wrapText="true"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
