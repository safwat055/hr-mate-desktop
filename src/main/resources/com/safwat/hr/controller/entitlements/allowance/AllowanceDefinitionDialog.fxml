<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    شاشة إدارة قواعد البدلات — AllowanceDefinitionDialog
    ────────────────────────────────────────────────────────────
    ① جدول كل القواعد
    ② جدول تاريخ الكود المختار
    ③ فورم إضافة / تعديل snapshot (الإخفاء والإظهار بيتم في الكنترولر)
-->

<ScrollPane fitToWidth="true" nodeOrientation="RIGHT_TO_LEFT" prefHeight="800" prefWidth="1180"
            styleClass="app-bg" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.safwat.hr.controller.entitlements.allowance.AllowanceDefinitionDialogController">
    <content>
        <VBox nodeOrientation="RIGHT_TO_LEFT" spacing="16">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <!-- ══════════ عنوان الشاشة ══════════ -->
            <Label alignment="CENTER" maxWidth="Infinity" text="إدارة قواعد البدلات" styleClass="bold fs-18"/>

            <!-- ══════════ ① كل القواعد ══════════ -->
            <VBox styleClass="card" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel-header">
                    <Label text="كل قواعد البدلات" styleClass="bold fs-14" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btn_new_code" text="+ بدل جديد" styleClass="btn-success" prefHeight="32"/>
                </HBox>

                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <TableView fx:id="table_definitions" editable="false" minHeight="220" prefHeight="300"
                               nodeOrientation="RIGHT_TO_LEFT" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="col_def_code" prefWidth="100" text="الكود"/>
                            <TableColumn fx:id="col_def_nameAr" prefWidth="220" text="الاسم"/>
                            <TableColumn fx:id="col_def_effectiveFrom" prefWidth="110" text="أحدث سريان"/>
                            <TableColumn fx:id="col_def_effectiveTo" prefWidth="110" text="ينتهي في"/>
                            <TableColumn fx:id="col_def_behavior" prefWidth="100" text="السلوك"/>
                            <TableColumn fx:id="col_def_calcType" prefWidth="190" text="نوع الاحتساب"/>
                            <TableColumn fx:id="col_def_elementType" prefWidth="130" text="طبيعة العنصر"/>
                            <TableColumn fx:id="col_def_scope" prefWidth="90" text="النطاق"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ══════════ ② تاريخ الكود المختار ══════════ -->
            <VBox styleClass="card" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="panel-header">
                    <Label fx:id="lbl_history_title" text="اختر بدل من الأعلى لعرض تاريخه"
                           styleClass="bold fs-14" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btn_new_snapshot" text="+ تاريخ سريان جديد" styleClass="btn-purple" prefHeight="32"/>
                </HBox>

                <VBox spacing="8">
                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>
                    <TableView fx:id="table_history" editable="false" minHeight="220" prefHeight="280"
                               nodeOrientation="RIGHT_TO_LEFT" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="col_hist_effectiveFrom" prefWidth="110" text="من تاريخ"/>
                            <TableColumn fx:id="col_hist_effectiveTo" prefWidth="110" text="إلى تاريخ"/>
                            <TableColumn fx:id="col_hist_behavior" prefWidth="100" text="السلوك"/>
                            <TableColumn fx:id="col_hist_calcType" prefWidth="190" text="نوع الاحتساب"/>
                            <TableColumn fx:id="col_hist_baseSource" prefWidth="150" text="مصدر الأساسي"/>
                            <TableColumn fx:id="col_hist_elementType" prefWidth="130" text="طبيعة العنصر"/>
                            <TableColumn fx:id="col_hist_actions" prefWidth="110" text="إجراءات"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ══════════ ③ فورم الإضافة / التعديل ══════════ -->
            <VBox fx:id="pane_form" styleClass="card" spacing="0">
                <HBox alignment="CENTER_LEFT" styleClass="panel-header">
                    <Label fx:id="lbl_form_title" text="إضافة قاعدة" styleClass="bold fs-14" maxWidth="Infinity"/>
                </HBox>

                <VBox spacing="14">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>

                    <!-- ── ① البيانات الأساسية ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="① البيانات الأساسية" styleClass="bold text-navy fs-13"/>
                        <Separator/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="الكود" styleClass="form-label"/>
                                <TextField fx:id="txt_code" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="الاسم بالعربي *" styleClass="form-label"/>
                                <TextField fx:id="txt_nameAr" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="الاسم بالإنجليزي" styleClass="form-label"/>
                                <TextField fx:id="txt_nameEn" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── ② فترة السريان ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="② فترة السريان" styleClass="bold text-navy fs-13"/>
                        <Separator/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="تاريخ السريان *" styleClass="form-label"/>
                                <TextField fx:id="txt_effectiveFrom" prefHeight="36" maxWidth="Infinity" promptText="2024-07-01"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="تاريخ النهاية (فارغ = مفتوح)" styleClass="form-label"/>
                                <TextField fx:id="txt_effectiveTo" prefHeight="36" maxWidth="Infinity" promptText="فارغ = ساري"/>
                            </VBox>
                            <VBox fx:id="pane_referenceDate" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="التاريخ المرجعي *" styleClass="form-label"/>
                                <TextField fx:id="txt_referenceDate" prefHeight="36" maxWidth="Infinity" promptText="2015-07-01"/>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="السلوك *" styleClass="form-label"/>
                                <ComboBox fx:id="combo_behavior" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label text="نوع الاحتساب *" styleClass="form-label"/>
                                <ComboBox fx:id="combo_calcType" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── ③ طريقة الاحتساب ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="③ طريقة الاحتساب" styleClass="bold text-navy fs-13"/>
                        <Separator/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="مصدر الأساسي" styleClass="form-label"/>
                                <ComboBox fx:id="combo_baseSource" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox fx:id="pane_insuranceBase" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="وعاء التأمين *" styleClass="form-label"/>
                                <ComboBox fx:id="combo_insuranceBase" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="طبيعة العنصر *" styleClass="form-label"/>
                                <ComboBox fx:id="combo_elementType" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="مصدر الدرجة" styleClass="form-label"/>
                                <ComboBox fx:id="combo_timelineAnchor" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="النطاق" styleClass="form-label"/>
                                <ComboBox fx:id="combo_scope" prefHeight="36" maxWidth="Infinity"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── ④ القيم ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="④ القيم" styleClass="bold text-navy fs-13"/>
                        <Separator/>

                        <VBox fx:id="pane_valuesMap" spacing="8">
                            <Label text="القيم (اختر المفتاح وأدخل القيمة) *" styleClass="form-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button fx:id="btn_add_map_entry" text="+ إضافة" styleClass="btn-success" prefHeight="34"/>
                                <ComboBox fx:id="combo_map_key" prefHeight="34" prefWidth="300" promptText="اختر المفتاح"/>
                                <TextField fx:id="txt_map_value" prefHeight="34" prefWidth="140" promptText="القيمة"/>
                            </HBox>
                            <TableView fx:id="table_values" editable="false" minHeight="150" prefHeight="150"
                                       nodeOrientation="RIGHT_TO_LEFT">
                                <columns>
                                    <TableColumn fx:id="col_map_key" prefWidth="260" text="المفتاح"/>
                                    <TableColumn fx:id="col_map_value" prefWidth="140" text="القيمة"/>
                                    <TableColumn fx:id="col_map_actions" prefWidth="90" text="إجراءات"/>
                                </columns>
                            </TableView>
                        </VBox>

                        <GridPane hgap="16" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="الحد الأدنى للقيمة" styleClass="form-label"/>
                                <TextField fx:id="txt_minValue" prefHeight="34" maxWidth="Infinity" promptText="فارغ = بدون حد أدنى"/>
                            </VBox>
                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="الحد الأقصى للقيمة" styleClass="form-label"/>
                                <TextField fx:id="txt_maxValue" prefHeight="34" maxWidth="Infinity" promptText="فارغ = بدون حد أقصى"/>
                            </VBox>
                            <VBox spacing="2" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label text="اختياري: لو القيمة المحتسبة أقل من الحد الأدنى تترفع تلقائياً، ولو أكبر من الحد الأقصى تتخفض تلقائياً." styleClass="text-muted fs-12"/>
                                <Label text="الأرقام موجبة، والحد الأدنى لا يزيد عن الحد الأقصى." styleClass="text-muted fs-12"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── ⑤ الخصائص ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="⑤ الخصائص" styleClass="bold text-navy fs-13"/>
                        <Separator/>
                        <FlowPane hgap="28" vgap="10" nodeOrientation="RIGHT_TO_LEFT">
                            <CheckBox fx:id="chk_subjectToInsurance" selected="true" text="خاضع للتأمينات" styleClass="form-checkbox"/>
                            <CheckBox fx:id="chk_subjectToTaxAndStamp" selected="true" text="خاضع للضريبة والدمغة" styleClass="form-checkbox"/>
                            <CheckBox fx:id="chk_inMinimumWageBase" selected="true" text="يدخل في وعاء التكميلي" styleClass="form-checkbox"/>
                            <CheckBox fx:id="chk_displayOnly" text="عرض فقط" styleClass="form-checkbox"/>
                            <CheckBox fx:id="chk_appliesToNewHires" selected="true" text="يستحق للمعينين الجدد" styleClass="form-checkbox"/>
                        </FlowPane>
                    </VBox>

                    <!-- ── ⑥ نطاق الاستحقاق ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="⑥ نطاق الاستحقاق" styleClass="bold text-navy fs-13"/>
                        <Separator/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="القوانين (اختياري)" styleClass="form-label"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button fx:id="btn_pick_laws" text="اختر" styleClass="btn-secondary" prefHeight="36" prefWidth="90"/>
                                    <TextField fx:id="txt_eligibleLaws" editable="false" focusTraversable="false"
                                               prefHeight="36" promptText="الكل = فارغ" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>

                            <VBox fx:id="pane_sector" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="lbl_sectorTitle" text="القطاعات (اختياري)" styleClass="form-label"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button fx:id="btn_pick_sectors" text="اختر" styleClass="btn-secondary" prefHeight="36" prefWidth="90"/>
                                    <TextField fx:id="txt_selectedSectors" editable="false" focusTraversable="false"
                                               prefHeight="36" promptText="الكل = فارغ" HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Label text="الوظائف (اختياري)" styleClass="form-label"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button fx:id="btn_pick_jobTitles" text="اختر" styleClass="btn-secondary" prefHeight="36" prefWidth="90"/>
                                    <TextField fx:id="txt_eligibleJobTitles" editable="false" focusTraversable="false"
                                               prefHeight="36" promptText="الكل = فارغ" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Label fx:id="lbl_jobTitlesHint" styleClass="text-muted fs-12"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- ── ⑦ الاستثناءات والملاحظات ── -->
                    <VBox spacing="10" styleClass="soft-box">
                        <padding>
                            <Insets top="10" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="⑦ الاستثناءات والملاحظات" styleClass="bold text-navy fs-13"/>
                        <Separator/>

                        <VBox spacing="6">
                            <Label text="الشهور المستثناة (MM أو yyyy-MM، مفصولة بفاصلة)" styleClass="form-label"/>
                            <TextField fx:id="txt_excludedMonths" prefHeight="36" promptText="مثال: 08, 2023-09"/>
                            <Label fx:id="lbl_excludedMonthsHint" text="تنبيه خاص بنوع الاحتساب" styleClass="text-danger fs-12"/>
                            <Label text="MM = الشهر في كل السنين، yyyy-MM = شهر محدد" styleClass="text-muted fs-12"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="ملاحظات" styleClass="form-label"/>
                            <TextArea fx:id="txt_notes" prefHeight="80" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- ── الخطأ وأزرار الحفظ ── -->
                    <Label fx:id="lbl_form_error" text="رسالة الخطأ" styleClass="text-danger fs-12"/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button fx:id="btn_save_definition" text="حفظ" styleClass="btn-primary" prefHeight="38" prefWidth="120"/>
                        <Button fx:id="btn_cancel_form" text="إلغاء" styleClass="btn-secondary" prefHeight="38" prefWidth="100"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ══════════ زر الإغلاق ══════════ -->
            <HBox alignment="CENTER_LEFT">
                <Button fx:id="btn_close" text="إغلاق" styleClass="btn-secondary" prefHeight="38" prefWidth="110"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>